# ============================================
# CONFIGURACIÓN DE ANALYTICS Y TRACKING
# Reemplaza los valores XXXXXXXXXX con tus IDs reales
# Luego renombra este archivo a: .env
# ============================================

# Google Analytics 4 (obligatorio para SEO básico)
# Obténlo en: https://analytics.google.com → Admin → Property Settings → Data Streams
GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Google Ads Conversion Tracking (opcional - para campañas pagadas)
# Obténlo en: https://ads.google.com → Tools & Settings → Conversions
GOOGLE_ADS_ID=AW-XXXXXXXXXX

# Meta Pixel para Facebook/Instagram Ads (opcional)
# Obténlo en: https://business.facebook.com/events_manager
META_PIXEL_ID=000000000000000
