---
export interface Props {
  lang: 'en' | 'es';
}
const { lang } = Astro.props;
---

<!-- ACADEMY MODULES SECTION -->
<section id="academy" class="bg-card text-primary py-24 border-t border-primary/10 relative z-10 shadow-inner">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid md:grid-cols-12 gap-16">
      <!-- Left CTA -->
      <div class="md:col-span-5 flex flex-col items-start sticky top-32 h-fit">
        <div class="font-outfit flex items-center gap-2 text-cta text-sm tracking-widest uppercase mb-4">
          <span>✦</span>
          {lang === 'en' ? 'Real Practical Value' : 'Valor Práctico Real'}
        </div>
        <h2 class="text-4xl md:text-5xl font-heading font-bold leading-tight mb-8 text-primary">
          {lang === 'en' ? 'What do you find in the Academy?' : '¿Qué encontrás en la Academia?'}
        </h2>
        <p class="font-outfit text-justify text-dark/80 text-lg leading-relaxed mb-6">
          {lang === 'en'
            ? <>Our Skool community is totally online and interactive, featuring <strong class="text-primary font-bold">complete blueprints</strong>, direct mentorship, and a huge library of digital assets.</>
            : <>Nuestra comunidad en Skool es totalmente online e interactiva, con <strong class="text-primary font-bold">blueprints completos</strong>, mentoría directa y una enorme biblioteca de recursos digitales.</>
          }
        </p>
        <a
          href="https://skool.com/deafdigitalpro"
          target="_blank"
          onclick="if(window.trackEvent)window.trackEvent('click_academy_premium','cta','academy_section',1)"
          class="font-outfit bg-gradient-to-r from-cta to-cta-hover hover:from-cta-hover hover:to-dark text-white px-8 py-4 rounded-lg transition-all shadow-lg flex items-center gap-2"
        >
          {lang === 'en' ? 'Join Premium Now ↗' : 'Unirse a Premium ↗'}
        </a>
      </div>

      <!-- Right List -->
      <div class="md:col-span-7 space-y-12 mt-12 md:mt-0">
        {[
          {
            n: '01',
            en: { title: 'Introduction to Passive Income', desc: 'Understand the proposal and discover why digital products are the natural evolution for entrepreneurs.' },
            es: { title: 'Introducción a los Ingresos Pasivos', desc: 'Entiende la propuesta y descubre por qué los productos digitales son la evolución natural para emprendedores.' },
          },
          {
            n: '02',
            en: { title: 'Market Positioning', desc: 'Learn how to present yourself as a digital professional without having to show your face.' },
            es: { title: 'Posicionamiento de Mercado', desc: 'Aprende a presentarte como profesional digital sin necesidad de mostrar tu cara.' },
          },
          {
            n: '03',
            en: { title: 'Creating Assets', desc: 'Discover what tools you already dominate and what you need to adjust to create e-books and courses.' },
            es: { title: 'Creación de Activos', desc: 'Descubre qué herramientas ya dominás y qué necesitás ajustar para crear e-books y cursos.' },
          },
          {
            n: '04',
            en: { title: 'Do I need design skills?', desc: 'Understand how to use templates and references without needing to be an expert graphic designer.' },
            es: { title: '¿Necesito saber diseño?', desc: 'Aprende a usar plantillas y referencias sin necesidad de ser experta en diseño gráfico.' },
          },
          {
            n: '05',
            en: { title: 'Automation & Sales', desc: 'Learn to apply systems to guarantee security, automated delivery, and scalable precision.' },
            es: { title: 'Automatización y Ventas', desc: 'Aplica sistemas que garanticen seguridad, entrega automatizada y precisión escalable.' },
          },
        ].map(item => (
          <div class="flex gap-6 group">
            <div class="text-4xl font-heading font-black text-primary/30 group-hover:text-cta transition-colors">{item.n}</div>
            <div>
              <h3 class="text-2xl font-bold mb-2 text-primary">
                {lang === 'en' ? item.en.title : item.es.title}
              </h3>
              <p class="font-outfit text-dark/70 text-lg text-justify group-hover:text-dark transition-colors">
                {lang === 'en' ? item.en.desc : item.es.desc}
              </p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
