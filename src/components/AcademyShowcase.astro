---
// src/components/AcademyShowcase.astro
export interface Props {
  mainImage?: string;
  videoUrl?: string;
}

const {
  mainImage = "/images/analia-libros.png",
  videoUrl = "/videos/videoespanol.mp4",
} = Astro.props;
---

<section class="py-8 md:py-8 px-4 bg-white">
  <div class="mx-auto w-full max-w-6xl">
    
    <!-- CANVAS CONTAINER: Aspect-ratio fijo 18:9 -->
    <div class="relative w-full min-h-[50px] md:min-h-[500px] aspect-[16/9] md:aspect-[18/9]">
      
      <!-- VIDEO COMPLETO (que ya incluye los mockups) -->
      <div class="absolute z-10 top-0 left-0 w-full h-full flex items-center justify-center">
        <video 
          autoplay 
          muted 
          loop 
          playsinline 
          preload="metadata"
          class="w-full h-full object-contain"
        >
          <source src={videoUrl} type="video/mp4" />
        </video>
      </div>

      <!-- Imagen cliente: posicionada absolutamente encima del video -->
      <img 
        src={mainImage} 
        alt="Analía Camarda con sus libros"
        class="absolute z-20 left-0 bottom-4 md:bottom-12 h-full object-contain object-bottom pointer-events-none"
        style="width: clamp(150px, 40%, 500px);"
      />

    </div>
  </div>
</section>

<style>
  @media (prefers-reduced-motion: reduce) {
    section video { 
      display: none !important; 
    }
  }
</style>