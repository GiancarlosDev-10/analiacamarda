---
const MEASUREMENT_ID  = import.meta.env.GA_MEASUREMENT_ID  || 'G-XXXXXXXXXX';
const GOOGLE_ADS_ID   = import.meta.env.GOOGLE_ADS_ID      || 'AW-XXXXXXXXXX';

// Descomentar cuando se activen campañas de Meta Ads:
// const PIXEL_ID = import.meta.env.META_PIXEL_ID || '000000000000000';
---

<!-- Google Analytics + Google Ads -->
<script async src={`https://www.googletagmanager.com/gtag/js?id=${MEASUREMENT_ID}`}></script>
<script define:vars={{ MEASUREMENT_ID, GOOGLE_ADS_ID }}>
  window.dataLayer = window.dataLayer || [];
  function gtag(){ dataLayer.push(arguments); }
  gtag('js', new Date());

  if (MEASUREMENT_ID && !MEASUREMENT_ID.includes('XXXXXXXXXX')) {
    gtag('config', MEASUREMENT_ID);
  }

  if (GOOGLE_ADS_ID && !GOOGLE_ADS_ID.includes('XXXXXXXXXX')) {
    gtag('config', GOOGLE_ADS_ID);
  }

  // Helper global para rastreo de eventos (usado en todos los componentes)
  window.trackEvent = function(action, category, label, value) {
    if (typeof gtag !== 'undefined') {
      gtag('event', action, {
        event_category: category,
        event_label:    label,
        value:          value,
      });
    }
  };
</script>

