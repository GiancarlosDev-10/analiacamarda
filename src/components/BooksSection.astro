---
import { Image } from 'astro:assets';
import booksData from '../data/books.json';
import { resolveImage } from '../utils/images';

export interface Props {
  lang: 'en' | 'es';
}

const { lang } = Astro.props;

// Resolve all book covers from assets
const books = await Promise.all(
  booksData
    .filter(b => b.lang === lang)
    .map(async (book) => {
      try {
        const imageAsset = await resolveImage(book.coverImage);
        return { ...book, imageAsset };
      } catch (e) {
        console.error(e);
        return { ...book, imageAsset: null };
      }
    })
);
---

<section id="books" class="bg-background text-primary py-20 relative overflow-hidden">
  <!-- Big background text -->
  <div class="absolute top-0 w-full text-center mt-6 pointer-events-none z-0">
    <p class="text-[12vw] font-heading font-black text-primary/5 tracking-widest whitespace-nowrap uppercase select-none">
      {lang === 'en' ? 'LIBRARY' : 'LIBRERÍA'}
    </p>
  </div>

  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <!-- Section header -->
    <div class="text-center mb-16">
      <div class="font-outfit flex justify-center items-center gap-2 text-cta text-sm tracking-widest uppercase mb-4">
        <span>✦</span> {lang === 'en' ? 'Knowledge at your fingertips' : 'Conocimiento a tu alcance'}
      </div>
      <h2 class="text-4xl md:text-5xl font-heading font-bold text-primary">
        {lang === 'en' ? 'My E-Books' : 'Mis E-Books'}
      </h2>
    </div>

    <!-- Horizontal book cards -->
    <div class="space-y-10">
      {books.map((book, i) => {
        const isEven = i % 2 === 0;
        const detailHref = lang === 'en' ? `/en/books/${book.slug}` : `/es/libros/${book.slug}`;
        return (
          <div class={`group flex flex-col ${isEven ? 'md:flex-row' : 'md:flex-row-reverse'} gap-0 rounded-2xl border border-primary/15 overflow-hidden shadow-md hover:shadow-2xl transition-all duration-500 bg-card`}>

            <!-- Cover image -->
            <div class="w-full md:w-2/5 overflow-hidden relative">
              {book.imageAsset && (
                <Image
                  src={book.imageAsset}
                  alt={book.title}
                  class="w-full h-64 md:h-full object-cover object-center group-hover:scale-105 transition-transform duration-700"
                />
              )}
              <!-- Price badge -->
              <div class="absolute top-4 left-4 bg-primary text-card px-4 py-1.5 rounded-full font-outfit text-lg shadow-lg">
                ${book.price.toFixed(2)}
              </div>
            </div>

            <!-- Content -->
            <div class="w-full md:w-3/5 p-8 md:p-10 flex flex-col justify-between">
              <div>
                <!-- For whom tag -->
                <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-primary/10 text-cta text-xs font-outfit tracking-widest uppercase mb-4">
                  <span>✦</span> {book.forWhom}
                </div>

                <!-- Title -->
                <h3 class="text-2xl md:text-3xl font-heading font-bold text-primary mb-4 leading-tight">
                  {book.title}
                </h3>

                <!-- Description -->
                <p class="font-outfit text-dark/75 text-lg text-justify leading-relaxed mb-6">
                  {book.description}
                </p>

                <!-- What you learn -->
                {book.whatYouLearn && book.whatYouLearn.length > 0 && (
                  <ul class="space-y-2 mb-6">
                    {book.whatYouLearn.map(item => (
                      <li class="flex items-center gap-2 font-outfit text-lg text-dark/80">
                        <span class="text-cta font-bold">✦</span> {item}
                      </li>
                    ))}
                  </ul>
                )}
              </div>

              <!-- CTA -->
              <div class="flex items-center gap-4 mt-4 pt-6 border-t border-primary/10">
                <a
                  href={detailHref}
                  onclick={`if(window.trackEvent)window.trackEvent('click_view_book','book_details','${book.slug}',1)`}
                  class="bg-primary hover:bg-dark text-card px-6 py-3 rounded-lg font-outfit transition-colors text-lg"
                >
                  {lang === 'en' ? 'View Details →' : 'Ver Detalles →'}
                </a>
                <span class="font-outfit text-xs text-dark/50 uppercase tracking-widest">
                  {lang === 'en' ? 'Digital Download' : 'Descarga Digital'}
                </span>
              </div>
            </div>
          </div>
        );
      })}
    </div>
  </div>
</section>
