---
import { Image } from 'astro:assets';
import booksData from '../data/books.json';
import { resolveImage } from '../utils/images';

export interface Props {
  lang: 'en' | 'es';
}

const { lang } = Astro.props;

// Resolve all book covers from assets
const books = await Promise.all(
  booksData
    .filter(b => b.lang === lang)
    .map(async (book) => {
      try {
        const imageAsset = await resolveImage(book.coverImage);
        return { ...book, imageAsset };
      } catch (e) {
        console.error(e);
        return { ...book, imageAsset: null };
      }
    })
);
---

<section id="books" class="bg-card text-primary py-12 md:py-28 relative overflow-hidden">
  <!-- Big background text -->
  <div class="absolute top-0 w-full text-center mt-6 pointer-events-none z-0">
    <p class="text-[12vw] font-heading font-black text-primary/5 tracking-widest whitespace-nowrap uppercase select-none">
      {lang === 'en' ? 'LIBRARY' : 'LIBRERÍA'}
    </p>
  </div>

  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <!-- Section header -->
    <div class="text-center mb-16">
      <div class="font-outfit flex justify-center items-center gap-2 text-cta text-sm tracking-widest uppercase mb-4">
        <span>✦</span> {lang === 'en' ? 'Knowledge at your fingertips' : 'Conocimiento a tu alcance'}
      </div>
      <h2 class="text-4xl md:text-5xl font-heading font-bold text-primary">
        {lang === 'en' ? 'My E-Books' : 'Mis E-Books'}
      </h2>
    </div>

    <!-- Horizontal book cards -->
    <div class="space-y-10">
      {books.map((book, i) => {
        const isEven = i % 2 === 0;
        const detailHref = lang === 'en' ? `/en/books/${book.slug}` : `/es/libros/${book.slug}`;
        return (
          <div class={`group flex flex-col ${isEven ? 'lg:flex-row' : 'lg:flex-row-reverse'} gap-0 rounded-2xl border border-primary/15 overflow-hidden shadow-md hover:shadow-2xl transition-all duration-500 bg-card min-h-[300px] md:min-h-[400px]`}>

            <!-- Cover image -->
            <div class="w-full lg:w-1/2 overflow-hidden relative h-48 sm:h-64 lg:h-auto bg-primary/5 flex items-center justify-center p-4">
              {book.imageAsset
                ? <Image
                    src={book.imageAsset}
                    alt={book.title}
                    loading="lazy"
                    class="w-full h-full object-contain object-center group-hover:scale-110 transition-transform duration-700 drop-shadow-2xl"
                  />
                : <div class="w-full h-full bg-primary/10 flex items-center justify-center rounded-xl">
                    <span class="text-primary/30 text-4xl">📚</span>
                  </div>
              }
              <!-- Badge de precio -->
              <div class="absolute top-4 left-4 bg-primary text-card px-4 py-1 rounded-full font-outfit text-sm lg:text-base md:text-lg font-bold shadow-lg">
                ${book.price.toFixed(2)}
              </div>
            </div>

            <!-- Content -->
            <div class="w-full lg:w-1/2 p-4 sm:p-6 lg:p-12 flex flex-col justify-center">
              <div>

                <!-- Title -->
                <h3 class="text-xl sm:text-2xl lg:text-4xl font-heading font-bold text-primary mb-4 leading-tight">
                  {book.title}
                </h3>

                <p class="font-outfit text-dark/75 text-sm sm:text-base lg:text-lg text-justify leading-relaxed mb-6">
                  {book.description}
                </p>

                {book.whatYouLearn && book.whatYouLearn.length > 0 && (
                  <ul class="space-y-2 mb-8">
                    {book.whatYouLearn.map(item => (
                      <li class="flex items-start gap-3 font-outfit text-sm lg:text-base text-dark/80">
                        <span class="text-cta font-bold mt-1">✦</span> {item}
                      </li>
                    ))}
                  </ul>
                )}
              </div>

              <!-- CTA -->
              <div class="flex items-center gap-4 mt-auto pt-6 border-t border-primary/10">
                <a
                  href={detailHref}
                  onclick={`if(window.trackEvent)window.trackEvent('click_view_book','book_details','${book.slug}',1)`}
                  class="bg-primary hover:bg-dark text-card px-6 py-3 lg:px-10 lg:py-4 rounded-xl font-outfit transition-all text-sm lg:text-base md:text-lg font-bold shadow-lg hover:-translate-y-1"
                >
                  {lang === 'en' ? 'View Details →' : 'Ver Detalles →'}
                </a>
                <span class="font-outfit text-xs lg:text-sm text-dark/80 uppercase tracking-widest font-bold">
                  {lang === 'en' ? 'Digital Edition' : 'Edición Digital'}
                </span>
              </div>
            </div>
          </div>
        );
      })}
    </div>
  </div>
</section>
