---
import { Image } from 'astro:assets';
import visaIcon from '../assets/images/visa.svg';
import mastercardIcon from '../assets/images/mastercard.svg';
import paypalIcon from '../assets/images/paypal.svg';

interface Props {
  id: string;
  bookTitle: string;
  price: number;
  currency: string;
  lang?: 'en' | 'es';
}

const { id, bookTitle, price, currency, lang = 'en' } = Astro.props;

const t = {
  en: {
    title: "Secure Checkout",
    subtitle: "✦ Premium Direct Access",
    product: "Product:",
    total: "Total:",
    cardLabel: "Credit or Debit Card",
    namePlace: "Cardholder Name",
    expiryPlace: "MM/YY",
    cvvPlace: "CVV",
    submit: "Complete Order Securely",
    close: "Close",
    ssl: "SSL Encrypted",
    pci: "PCI Compliant",
    successRedirect: "/en/thank-you"
  },
  es: {
    title: "Pago Seguro",
    subtitle: "✦ Acceso Directo Premium",
    product: "Producto:",
    total: "Total:",
    cardLabel: "Tarjeta de Crédito o Débito",
    namePlace: "Nombre del Titular",
    expiryPlace: "MM/AA",
    cvvPlace: "CVV",
    submit: "Completar Pedido con Seguridad",
    close: "Cerrar",
    ssl: "SSL Encriptado",
    pci: "Cumple PCI",
    successRedirect: "/es/exito"
  }
}[lang];
---

<div 
  id={id} 
  class="fixed inset-0 z-[100] hidden items-center justify-center p-4 bg-primary/60 backdrop-blur-md transition-opacity duration-300 overflow-hidden"
  role="dialog"
  aria-labelledby="modal-title"
  aria-modal="true"
>
  <div class="bg-card w-full max-w-lg rounded-2xl shadow-2xl border border-primary/20 overflow-hidden transform transition-all scale-95 duration-300 opacity-0 modal-content">
    
    <!-- Modal Header -->
    <div class="bg-primary p-4 text-card flex justify-between items-center">
      <div>
        <h2 id="modal-title" class="text-2xl font-heading font-bold">{t.title}</h2>
        <p class="text-xs font-outfit uppercase tracking-widest text-background mt-1">{t.subtitle}</p>
      </div>
      <button id={`close-${id}`} class="text-card/50 hover:text-card transition-colors p-2 focus:outline-none focus:ring-2 focus:ring-cta rounded-full" aria-label={t.close}>
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
      </button>
    </div>

    <!-- Order Summary -->
    <div class="p-3 border-b border-primary/10 bg-background/50 flex justify-between items-center">
      <div class="space-y-1">
        <p class="text-[10px] font-bold uppercase tracking-widest text-dark/40">{t.product}</p>
        <p class="font-bold text-primary font-heading line-clamp-1">{bookTitle}</p>
      </div>
      <div class="text-right">
        <p class="text-[10px] font-bold uppercase tracking-widest text-dark/40">{t.total}</p>
        <p class="text-xl font-bold font-outfit text-cta">${price.toFixed(2)} {currency}</p>
      </div>
    </div>

    <!-- Main Payment Container -->
    <div class="p-2 space-y-8 max-h-[70vh] overflow-y-auto">
      
      <!-- Sección de Tarjeta (Stripe Link) -->
      <div class="space-y-4">
        <a 
            href={import.meta.env.STRIPE_LINK || '#'} 
            target="_blank"
            onclick={`if(window.trackEvent)window.trackEvent('click_purchase_card','purchase','${bookTitle}',${price})`}
            class="font-outfit w-full bg-cta hover:bg-cta-hover text-white py-4 rounded-xl shadow-xl flex items-center justify-center gap-3 transition-all transform active:scale-95 text-base font-bold"
          >
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"/></svg>
            {t.cardLabel}
          </a>

        <div class="relative flex items-center gap-4 px-4">
          <div class="flex-grow border-t border-primary/10"></div>
          <span class="text-[10px] font-bold text-dark/30 uppercase tracking-widest">OR</span>
          <div class="flex-grow border-t border-primary/10"></div>
        </div>

        <!-- Botón de PayPal (PayPal Link) -->
        <a 
            href={import.meta.env.PAYPAL_LINK || '#'} 
            target="_blank"
            onclick={`if(window.trackEvent)window.trackEvent('click_purchase_paypal','purchase','${bookTitle}',${price})`}
            class="w-full bg-[#ffc439] hover:bg-[#ffb700] py-4 rounded-xl flex items-center justify-center gap-2 transition-all hover:scale-[1.02] shadow-lg border-2 border-[#e6a823]"
          >
            <Image src={paypalIcon} alt="PayPal" class="h-8 w-auto" />
            <span class="font-outfit font-bold text-[#003087]">PayPal</span>
          </a>
      </div>

      <!-- High Contrast Trust Block -->
      <div class="flex items-center justify-center gap-8 py-4 border-t border-primary/5">
        <div class="flex items-center gap-2 text-primary">
          <svg class="w-5 h-5 text-cta" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M2.166 4.999A11.954 11.954 0 0010 1.944 11.954 11.954 0 0017.834 5c.11.65.166 1.32.166 2.001 0 4.908-3.067 9.126-7.399 10.8a.75.75 0 01-.601 0L2.666 16.101C1.042 14.331.166 12.012.166 10c0-.68.056-1.35.166-2.001zm6.584 1.252a.75.75 0 00-1.5 0v2.5c0 .414.336.75.75.75h2.5a.75.75 0 000-1.5h-1.75v-1.75z" clip-rule="evenodd"/></svg>
          <span class="text-[10px] font-black uppercase tracking-widest">{t.ssl}</span>
        </div>
        <div class="flex items-center gap-2 text-primary">
          <svg class="w-5 h-5 text-cta" fill="currentColor" viewBox="0 0 20 20"><path d="M4 4a2 2 0 00-2 2v1h16V6a2 2 0 00-2-2H4z"/><path fill-rule="evenodd" d="M18 9H2v5a2 2 0 002 2h12a2 2 0 002-2V9zM4 13a1 1 0 011-1h1a1 1 0 110 2H5a1 1 0 01-1-1zm5-1a1 1 0 100 2h1a1 1 0 100-2H9z" clip-rule="evenodd"/></svg>
          <span class="text-[10px] font-black uppercase tracking-widest">{t.pci}</span>
        </div>
      </div>

    </div>
  </div>
</div>

<script is:inline define:vars={{ id, successRedirect: t.successRedirect }}>
  const modal = document.getElementById(id);
  const content = modal?.querySelector('.modal-content');
  const closeBtn = document.getElementById(`close-${id}`);
  const firstInput = document.getElementById(`name-${id}`);
  const submitBtn = document.getElementById(`submit-${id}`);
  
  if (modal && closeBtn && content) {
    const track = (eventAction) => {
      // Mock GA4/GTM Call
      console.log(`[GA4 Event] ${eventAction}`, { 
        event_category: 'ecommerce',
        event_label: id 
      });
      if (window.dataLayer) {
        window.dataLayer.push({
          event: eventAction,
          checkout_id: id
        });
      }
    };

    const toggleModal = (show = null) => {
      const isHidden = modal.classList.contains('hidden');
      const shouldShow = show !== null ? show : isHidden;

      if (shouldShow) {
        // Open
        document.body.style.overflow = 'hidden';
        modal.classList.remove('hidden');
        modal.classList.add('flex');
        track('begin_checkout');
        
        setTimeout(() => {
          content.classList.remove('scale-95', 'opacity-0');
          content.classList.add('scale-100', 'opacity-100');
          firstInput?.focus();
        }, 10);
      } else {
        // Close
        content.classList.remove('scale-100', 'opacity-100');
        content.classList.add('scale-95', 'opacity-0');
        setTimeout(() => {
          modal.classList.add('hidden');
          modal.classList.remove('flex');
          document.body.style.overflow = '';
        }, 300);
      }
    };

    closeBtn.addEventListener('click', () => toggleModal(false));
    
    // Listen for custom trigger event
    document.addEventListener('open-checkout', (e) => {
      if (e.detail?.slug === id.replace('checkout-', '')) {
         toggleModal(true);
      }
    });

    // Close on backdrop click
    modal.addEventListener('click', (e) => {
      if (e.target === modal) toggleModal(false);
    });

    // Close on ESC key
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !modal.classList.contains('hidden')) {
        toggleModal(false);
      }
    });

    // Mock Submit & Success Flow
    submitBtn?.addEventListener('click', () => {
      track('add_payment_info');
      submitBtn.disabled = true;
      submitBtn.innerHTML = '<span class="animate-spin text-xl">✦</span>';
      
      setTimeout(() => {
        track('purchase');
        window.location.href = successRedirect;
      }, 1500);
    });
  }
</script>

<style>
  .bg-card {
    background: #fffefb;
  }
  
  /* Prevent iOS zoom on focus by ensuring font-size is at least 16px */
  input {
    font-size: 16px !important;
  }

  .animate-spin {
    display: inline-block;
    animation: spin 1s linear infinite;
  }

  @keyframes spin {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }
</style>

