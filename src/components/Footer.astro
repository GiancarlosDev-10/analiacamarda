---
import { Image } from 'astro:assets';
import logoImg from '../assets/images/analia-camarda.png';
import partnerLogo from '../assets/images/WiCyS_Deaf.png';

const currentYear = new Date().getFullYear();
const pathname = Astro.url.pathname;
const isSpanish = pathname.startsWith('/es');

const dic = {
  about: isSpanish 
    ? "Como emprendedora y graduada en ciberseguridad, fundé la Academia Digital, centrada en la educación digital accesible, las estrategias de marketing y la protección de datos." 
    : "As an entrepreneur and Cybersecurity graduate, I founded the Digital Academy, focused on accessible digital education, marketing strategies, and data protection.",
  linksTitle: isSpanish ? "Enlaces Rápidos" : "Quick Links",
  books: isSpanish ? "Libros" : "Books",
  booksHref: isSpanish ? "/es/libros" : "/en/books",
  academia: isSpanish ? "Academia Digital" : "Digital Academy",
  academiaHref: isSpanish ? "/es/academia" : "/en/academy",
  story: isSpanish ? "Sobre mí" : "About Me",
  storyHref: isSpanish ? "/es/sobre-mi" : "/en/aboutme",
  contact: isSpanish ? "Contacto directo" : "Contact Me",
  partnerTitle: "Partner",
  langTitle: isSpanish ? "Idioma / Language" : "Language / Idioma",
  langMain: isSpanish ? "Ir al Sitio en Inglés (English Site)" : "Go to Spanish Site (Sitio en Español)",
  langOppositeHref: isSpanish ? "/en/" : "/es/",
  rights: isSpanish ? `© ${currentYear} Analía Camarda. Todos los derechos reservados.` : `© ${currentYear} Analía Camarda. All rights reserved.`,
}
---
<footer class="bg-background text-dark py-6 border-t border-primary/20">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-3 gap-3 md:gap-12 text-left">
      <div class="space-y-3 md:space-y-6 text-left">
        <a href={isSpanish ? "/es" : "/"} class="inline-block transition-transform hover:scale-105" aria-label="Analía Camarda Home">
          <Image src={logoImg} alt="Analía Camarda" loading="lazy" class="w-full max-w-[80px] md:max-w-[160px] lg:max-w-[200px] h-auto object-contain"/>
        </a>
        <p class="hidden md:block text-dark/80 font-medium text-justify text-[10px] sm:text-xs md:text-base leading-tight md:leading-normal">{dic.about}</p>
      </div>
      <div>
        <h3 class="font-bold font-heading text-xs sm:text-sm md:text-xl mb-3 md:mb-6 text-primary">{dic.linksTitle}</h3>
        <ul class="space-y-2 md:space-y-4 text-[10px] sm:text-xs md:text-base">
          <li><a href={dic.booksHref} onclick="if(window.trackEvent)window.trackEvent('click_footer_books','footer','navigation',1)" class="text-dark/80 font-medium hover:text-cta transition-colors">{dic.books}</a></li>
          <li><a href={dic.academiaHref} onclick="if(window.trackEvent)window.trackEvent('click_footer_academy','footer','navigation',1)" class="text-dark/80 font-medium hover:text-cta transition-colors">{dic.academia}</a></li>
          <li><a href={dic.storyHref} onclick="if(window.trackEvent)window.trackEvent('click_footer_about','footer','navigation',1)" class="text-dark/80 font-medium hover:text-cta transition-colors">{dic.story}</a></li>
          <li><a href="https://wa.me/12393316702" target="_blank" rel="noopener noreferrer" onclick="if(window.trackEvent)window.trackEvent('click_footer_whatsapp','footer','contact',1)" class="text-dark/80 font-medium hover:text-cta transition-colors">{dic.contact}</a></li>
        </ul>
      </div>
      <div class="space-y-6 md:space-y-10">
        <div>
          <h3 class="font-bold font-heading text-xs sm:text-sm md:text-xl mb-3 md:mb-6 text-primary">{dic.langTitle}</h3>
          <ul class="space-y-2 md:space-y-4 text-[10px] sm:text-xs md:text-base">
            <li>
              <a href={dic.langOppositeHref} class="text-dark/80 font-medium hover:text-cta transition-colors flex items-start md:items-center gap-1 md:gap-2">
                <svg class="w-3 h-3 md:w-5 md:h-5 flex-shrink-0 mt-0.5 md:mt-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5h12M9 3v2m1.048 9.5A18.022 18.022 0 016.412 9m6.088 9h7M11 21l5-10 5 10M12.751 5C11.783 10.77 8.07 15.61 3 18.129"></path></svg>
                <span>{dic.langMain}</span>
              </a>
            </li>
          </ul>
        </div>
        <div>
          <h3 class="font-bold font-heading text-xs sm:text-sm md:text-xl mb-3 md:mb-6 text-primary">{dic.partnerTitle}</h3>
          <a 
            href="https://www.wicys.org/wicys-deaf-affiliate/" 
            target="_blank"
            rel="noopener noreferrer" 
            onclick="if(window.trackEvent)window.trackEvent('click_wicys_partner','footer','partner',1)"
            class="inline-block transition-transform hover:scale-105"
            aria-label="WiCyS Deaf Affiliate"
          >
            <Image 
              src={partnerLogo} 
              alt="WiCyS Deaf Partner Logo"
              loading="lazy"
              class="w-full max-w-[80px] md:max-w-32 h-auto object-contain opacity-90 hover:opacity-100 transition-opacity" 
            />
          </a>
        </div>
      </div>
    </div>
    <div class="border-t border-primary/10 mt-16 pt-8 flex items-center justify-center md:justify-between text-sm font-medium text-dark/60">
      <p>{dic.rights}</p>
    </div>
  </div>
</footer>