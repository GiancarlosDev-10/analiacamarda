---
import { Image } from 'astro:assets';
import logoImg from '../assets/images/analia-camarda.png';
import linkedinIcon from '../assets/images/linkedin.svg';
import instagramIcon from '../assets/images/instagram.svg';
import tiktokIcon from '../assets/images/tiktok.svg';

const pathname = Astro.url.pathname;
const isSpanish = pathname.startsWith('/es');

// Intelligent Language Switcher Logic
const getLangHref = (path: string): string => {
  const cleanPath = path.endsWith('/') && path.length > 1 ? path.slice(0, -1) : path;
  
  // Slug mappings for books and blog posts
  const slugsMap: Record<string, string> = {
    'silent-success': 'exito-silencioso',
    'ultimate-passive-income-blueprint': 'descubre-ingresos-pasivos',
    'exito-silencioso': 'silent-success',
    'descubre-ingresos-pasivos': 'ultimate-passive-income-blueprint',
    'why-passive-income': 'por-que-ingresos-pasivos',
    'por-que-ingresos-pasivos': 'why-passive-income',
    // Static Pages
    'aboutme': 'sobre-mi',
    'sobre-mi': 'aboutme',
    'academy': 'academia',
    'academia': 'academy',
    'gallery': 'galeria',
    'galeria': 'gallery'
  };

  let newPath = '';

  if (isSpanish) {
    // ES -> EN: Replace leading /es with /en
    newPath = cleanPath.replace(/^\/es($|\/)/, '/en$1');
    // Translate specific directory names
    newPath = newPath.replace(/\/libros($|\/)/, '/books$1');
  } else {
    // EN -> ES: Replace leading /en with /es, or handle root /
    if (cleanPath === '/') {
      newPath = '/es/';
    } else {
      newPath = cleanPath.replace(/^\/en($|\/)/, '/es$1');
      // If the path didn't have an /en prefix but was root-relative, prepend /es
      if (!cleanPath.startsWith('/en')) {
        newPath = `/es${cleanPath.startsWith('/') ? '' : '/'}${cleanPath}`;
      }
    }
    // Translate specific directory names
    newPath = newPath.replace(/\/books($|\/)/, '/libros$1');
  }

  // Apply slug translations at the end of the path (handles books, blog posts, and static pages)
  for (const s of Object.keys(slugsMap)) {
    if (newPath.endsWith(`/${s}`) || newPath.endsWith(s)) {
      const lastSlashIndex = newPath.lastIndexOf('/');
      if (lastSlashIndex !== -1) {
        newPath = newPath.substring(0, lastSlashIndex + 1) + slugsMap[s];
        break; // Stop once we've found and applied a translation
      }
    }
  }

  return newPath || (isSpanish ? '/en/' : '/es/');
};

const langHref = getLangHref(pathname);

const homeHref = isSpanish ? '/es/' : '/en/';
const booksHref = isSpanish ? '/es/libros' : '/en/books';
const academiaHref = isSpanish ? '/es/academia' : '/en/academy';
const aboutHref = isSpanish ? '/es/sobre-mi' : '/en/aboutme';
const galleryHref = isSpanish ? '/es/galeria' : '/en/gallery';
const blogHref = isSpanish ? '/es/blog' : '/en/blog';
const langMode = isSpanish ? 'English' : 'Spanish';

const translations = {
  about: isSpanish ? 'Sobre mí' : 'About Me',
  books: isSpanish ? 'Libros' : 'Books',
  blog: isSpanish ? 'Blog' : 'Blog',
  skool: 'Skool',
  gallery: isSpanish ? 'Galería' : 'Gallery',
};
---
<header class="bg-background/90 backdrop-blur-md w-full border-b border-primary/20 sticky top-0 z-50 transition-colors">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between items-center h-24">
      <div class="flex-shrink-0 flex items-center">
        <a href={homeHref} class="inline-block transition-transform hover:scale-103" aria-label="Analía Camarda Home">
          <Image src={logoImg} alt="Analía Camarda" class="h-28 w-auto object-contain scale-[1.1] transform origin-left" loading="eager" />
        </a>
      </div>
      <nav class="font-outfit hidden md:flex space-x-8 items-center">
        <a href={aboutHref} onclick="if(window.trackEvent)window.trackEvent('click_nav_about','navigation','header',1)" class="text-primary hover:text-dark transition-colors text-2xl capitalize">{translations.about}</a>
        <a href={booksHref} onclick="if(window.trackEvent)window.trackEvent('click_nav_books','navigation','header',1)" class="text-primary hover:text-dark transition-colors text-2xl capitalize">{translations.books}</a>
        <a href={blogHref} onclick="if(window.trackEvent)window.trackEvent('click_nav_blog','navigation','header',1)" class="text-primary hover:text-dark transition-colors text-2xl capitalize">{translations.blog}</a>
        <a href={academiaHref} onclick="if(window.trackEvent)window.trackEvent('click_nav_academy','navigation','header',1)" class="text-primary hover:text-dark transition-colors text-2xl capitalize">{translations.skool}</a>
        <a href={galleryHref} onclick="if(window.trackEvent)window.trackEvent('click_nav_gallery','navigation','header',1)" class="text-primary hover:text-dark transition-colors text-2xl capitalize">{translations.gallery}</a>
      </nav>
      <div class="font-outfit hidden md:flex items-center gap-8">
        <!-- Social Icons -->
        <div class="flex items-center gap-6">
          <!-- LinkedIn -->
          <a href="https://linkedin.com/in/yourprofile" target="_blank" onclick="if(window.trackEvent)window.trackEvent('click_social_linkedin','social','header',1)" class="transition-transform hover:scale-110" aria-label="LinkedIn">
            <Image src={linkedinIcon} alt="LinkedIn" class="w-8 h-8" />
          </a>
          <!-- Instagram -->
          <a href="https://instagram.com/yourprofile" target="_blank" onclick="if(window.trackEvent)window.trackEvent('click_social_instagram','social','header',1)" class="transition-transform hover:scale-110" aria-label="Instagram">
            <Image src={instagramIcon} alt="Instagram" class="w-8 h-8" />
          </a>
          <!-- TikTok -->
          <a href="https://tiktok.com/@yourprofile" target="_blank" onclick="if(window.trackEvent)window.trackEvent('click_social_tiktok','social','header',1)" class="transition-transform hover:scale-110" aria-label="TikTok">
            <Image src={tiktokIcon} alt="TikTok" class="h-8 w-auto" />
          </a>
        </div>

        <!-- Language Switcher Button -->
        <a id="lang-toggle" href={langHref} class="bg-primary hover:bg-dark text-card px-8 py-2.5 rounded-full font-bold transition-all shadow-md hover:shadow-lg text-lg">
          {langMode}
        </a>
      </div>
    </div>
  </div>
</header>

<script>
  // Script to preserve scroll position across language switches
  const setupLangToggle = () => {
    const langToggle = document.getElementById('lang-toggle');
    if (!langToggle) return;

    langToggle.addEventListener('click', (e) => {
      // List of sections to track
      const sections = ['mentor', 'books', 'why-digital', 'academy', 'newsletter'];
      let activeSection = '';

      // Find the section currently most visible in the viewport
      for (const id of sections) {
        const el = document.getElementById(id);
        if (el) {
          const rect = el.getBoundingClientRect();
          if (rect.top < window.innerHeight / 2 && rect.bottom > 100) {
            activeSection = id;
          }
        }
      }

      if (activeSection) {
        const currentHref = langToggle.getAttribute('href') || '';
        // Only append hash if not already present or different
        const baseHref = currentHref.split('#')[0];
        langToggle.setAttribute('href', `${baseHref}#${activeSection}`);
      }
    });
  };

  // Run on initial load
  setupLangToggle();
  // Support Astro View Transitions if the user decides to enable them later
  document.addEventListener('astro:after-swap', setupLangToggle);
</script>
