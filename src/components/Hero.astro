---
import { Image } from 'astro:assets';
import heroImg from '../assets/images/foto-hero.png';

export interface Props {
  lang: 'en' | 'es';
}
const { lang } = Astro.props;
---
<!-- HERO SECTION -->
<section class="relative bg-background text-primary overflow-hidden pt-4 pb-12 md:pt-6 md:pb-10">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 grid grid-cols-1 md:grid-cols-2 gap-8 md:gap-12 items-center md:items-start">
    <!-- Text content -->
    <div class="space-y-6 md:space-y-8 flex flex-col items-start order-2 md:order-1 mt-2 md:mt-0">
      
      {lang === 'en' ? (
        <Fragment>
          <h1 class="text-4xl md:text-5xl lg:text-6xl xl:text-7xl font-heading font-extrabold leading-[1.1] text-primary text-center md:text-left w-full">
            Digital Academy <span class="text-transparent bg-clip-text bg-gradient-to-r from-cta to-dark">Founded by </span> <br class="hidden lg:block"/>
            Analía Camarda
          </h1>
          <p class="font-outfit text-lg md:text-xl text-dark text-justify max-w-2xl leading-relaxed -mt-4">
           Analía Camarda is a Cybersecurity graduate, digital entrepreneur, and founder of the Digital Academy — an online education platform she built from scratch to empower the Deaf community and anyone ready to start their digital business. She teaches Cybersecurity, digital marketing, and online business in English, Spanish & Sign Language, using a step-by-step system that requires no prior experience.
          </p>
        </Fragment>
      ) : (
        <Fragment>
          <h1 class="text-4xl md:text-5xl lg:text-6xl xl:text-7xl font-heading font-extrabold leading-[1.1] text-primary text-center md:text-left w-full">
            Academia Digital <br class="hidden lg:block"/>
            <span class="text-transparent bg-clip-text bg-gradient-to-r from-cta to-dark">Fundada por</span> <br class="hidden lg:block"/>
            Analía Camarda
          </h1>
          <p class="font-outfit text-lg md:text-xl text-dark text-justify max-w-2xl leading-relaxed -mt-4">
            Analía Camarda es graduada en Ciberseguridad, emprendedora digital y fundadora de la Academia Digital — una plataforma de educación online que construyó desde cero para empoderar a la comunidad Sorda y a quienes están listos para iniciar su negocio digital. Enseña Ciberseguridad, marketing digital y negocios online en inglés, español y lengua de señas, con un sistema paso a paso que no requiere experiencia previa.
          </p> 
        </Fragment>
      )}
      
      <div class="font-outfit flex flex-col md:flex-row gap-4 -mt-4 w-full md:w-auto">
        <a href="https://skool.com/deafdigitalpro/plans" target="_blank" rel="noopener noreferrer" onclick="if(window.trackEvent)window.trackEvent('click_academy','cta','hero_button',1)" class="inline-flex justify-center items-center gap-2 bg-gradient-to-r from-cta to-cta-hover text-white px-6 py-4 rounded-lg transition-all shadow-md whitespace-nowrap text-center">
          {lang === 'en' ? 'Join the Academy ↗' : 'Únete a la Academia ↗'}
        </a>
        <a href="#books" onclick="if(window.trackEvent)window.trackEvent('click_books','cta','hero_button',1)" class="inline-flex justify-center items-center gap-2 text-primary px-6 py-4 rounded-lg transition-all border border-primary/20 bg-card/50 whitespace-nowrap text-center">
          {lang === 'en' ? 'See My Books' : 'Ver mis Libros'}
        </a>
      </div>
      
      <!-- Trust indicators -->
      <div class="font-outfit flex items-center justify-center md:justify-start gap-4 text-xl tracking-wide text-dark/70 w-full">
        <span class="uppercase text-center md:text-left">
          {lang === 'en' ? 'Trusted by 9k+ on Instagram' : 'Con la confianza de 9k+ en Instagram'}
        </span>
      </div>
    </div>
    
    <!-- Hero Image -->
    <div class="relative w-full flex justify-center items-end order-1 md:order-2 mt-8 md:mt-0">
      <!-- Glow effect -->
      <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-full h-full bg-primary/10 blur-[60px] md:blur-[100px] rounded-full pointer-events-none"></div>
      
      <!-- Floating badges -->
      <div class="absolute left-0 bottom-10 md:bottom-1/3 inline-flex items-center gap-2 px-3 py-2 rounded-full border border-primary/20 bg-background/80 backdrop-blur-md text-[10px] md:text-xs font-bold text-primary shadow-xl z-20">
        <span class="text-cta">✦</span> {lang === 'en' ? 'Made for Beginners' : 'Hecho para Principiantes'}
      </div>
      
      <div class="absolute right-0 bottom-20 md:bottom-1/4 inline-flex items-center gap-2 px-3 py-2 rounded-full border border-primary/20 bg-background/80 backdrop-blur-md text-[10px] md:text-xs font-bold text-primary shadow-xl z-20">
        <span class="text-cta">✦</span> {lang === 'en' ? 'Highly requested skills' : 'Habilidades de Alta Demanda'}
      </div>
      
      <div class="relative z-10 w-full max-w-[300px] md:max-w-md aspect-[3/4] rounded-t-full bg-gradient-to-b from-card to-transparent border-t border-x border-primary/20 overflow-hidden flex items-end justify-center shadow-2xl">
          <Image src={heroImg} alt="Analía Camarda" widths={[300, 500, 1000]} sizes="(max-width: 768px) 300px, (max-width: 1024px) 500px, 1000px" class="w-full h-auto object-contain transition-all duration-700 hover:scale-105" loading="eager" fetchpriority="high" />
      </div>
    </div>
  </div>
</section>