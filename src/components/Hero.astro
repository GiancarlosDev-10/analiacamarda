---
import { Image } from 'astro:assets';
import heroImg from '../assets/images/foto-hero.png';

export interface Props {
  lang: 'en' | 'es';
}
const { lang } = Astro.props;
---
<!-- HERO SECTION -->
<section class="relative bg-background text-primary overflow-hidden pt-4 pb-24 md:pt-8 md:pb-24">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 grid md:grid-cols-2 gap-12 items-start">
    <!-- Text content -->
    <div class="space-y-8 flex flex-col items-start mt-2 md:mt-0">
      
      {lang === 'en' ? (
        <Fragment>
          <h1 class="text-4xl md:text-5xl lg:text-6xl xl:text-7xl font-heading font-extrabold leading-[1.1] text-primary">
            Build <span class="text-transparent bg-clip-text bg-gradient-to-r from-cta to-dark">Passive&nbsp;Income </span> <br class="hidden lg:block"/>
            Successfully with <br class="hidden lg:block"/>
            Analía Camarda
          </h1>
          <p class="font-outfit text-lg md:text-xl text-dark text-justify max-w-lg leading-relaxed">
            Expand your skills, increase your income, and conquer a new digital market using the exact blueprints that gave me financial freedom.
          </p>
        </Fragment>
      ) : (
        <Fragment>
          <h1 class="text-4xl md:text-5xl lg:text-6xl xl:text-7xl font-heading font-extrabold leading-[1.1] text-primary">
            Construye <br class="hidden lg:block"/>
            <span class="text-transparent bg-clip-text bg-gradient-to-r from-cta to-dark">Ingresos Pasivos</span> <br class="hidden lg:block"/>
            Exitosamente&nbsp;con <br class="hidden lg:block"/>
            Analía Camarda
          </h1>
          <p class="font-outfit text-lg md:text-xl text-dark text-justify max-w-lg leading-relaxed">
            Expande tus habilidades, aumenta tus ingresos y conquista un nuevo mercado digital utilizando las exactas hojas de ruta que me dieron libertad financiera.
          </p> 
        </Fragment>
      )}
      
      <div class="font-outfit flex flex-col sm:flex-row gap-5 pt-1 w-full sm:w-auto">
        <a href="https://skool.com/deafdigitalpro" target="_blank" class="inline-flex justify-center items-center gap-2 bg-gradient-to-r from-cta to-cta-hover hover:from-cta-hover hover:to-dark text-white px-8 py-4 rounded-lg transition-all shadow-[0_4px_20px_rgba(139,69,19,0.3)] hover:shadow-[0_6px_25px_rgba(139,69,19,0.5)]">
          {lang === 'en' ? 'Join the Academy ↗' : 'Únete a la Academia ↗'}
        </a>
        <a href={lang === 'en' ? '#books' : '#libros'} class="inline-flex justify-center items-center gap-2 text-primary px-8 py-4 rounded-lg transition-all hover:bg-primary/5 border border-primary/20 hover:border-primary/40 bg-card/50">
          {lang === 'en' ? 'See My Books' : 'Ver mis Libros'}
        </a>
      </div>
      
      <!-- Trust indicators -->
      <div class="font-outfit flex items-center gap-4 text-xl tracking-wide text-dark/70">
        <span class="uppercase">
          {lang === 'en' ? 'Trusted by 9k+ on Instagram' : 'Con la confianza de 9k+ en Instagram'}
        </span>
      </div>
    </div>
    
    <!-- Hero Image -->
    <div class="relative h-full flex justify-center items-start hidden md:flex">
      <!-- Glow effect -->
      <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[120%] h-[120%] bg-primary/10 blur-[100px] rounded-full mix-blend-multiply pointer-events-none"></div>
      
      <!-- Floating badge left -->
      <div class="absolute left-0 bottom-1/3 inline-flex items-center gap-2 px-4 py-2 rounded-full border border-primary/20 bg-background/80 backdrop-blur-md text-xs font-bold text-primary shadow-xl z-20">
        <span class="text-cta">✦</span> {lang === 'en' ? 'Made for Beginners' : 'Hecho para Principiantes'}
      </div>
      
      <!-- Floating badge right -->
      <div class="absolute right-0 bottom-1/4 inline-flex items-center gap-2 px-4 py-2 rounded-full border border-primary/20 bg-background/80 backdrop-blur-md text-xs font-bold text-primary shadow-xl z-20">
        <span class="text-cta">✦</span> {lang === 'en' ? 'Highly requested skills' : 'Habilidades de Alta Demanda'}
      </div>
      
      <!-- Placeholder for Ana's cutout -->
      <div class="relative z-10 w-full max-w-md aspect-[3/4] rounded-t-full bg-gradient-to-b from-card to-transparent border-t border-x border-primary/20 overflow-hidden flex items-end justify-center shadow-2xl">
          <!-- Modifica este scr para cambiar la imagen del Hero -->
          <Image src={heroImg} alt="Analía Camarda" class="w-full h-full object-contain object-bottom transition-all duration-700 scale-125" loading="eager" />
      </div>
    </div>
  </div>
</section>
