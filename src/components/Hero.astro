---
import { Image } from 'astro:assets';
import heroImg from '../assets/images/foto-hero.png';

export interface Props {
  lang: 'en' | 'es';
}
const { lang } = Astro.props;
---
<!-- HERO SECTION -->
<section class="relative bg-background text-primary overflow-hidden pt-4 pb-24 md:pt-8 md:pb-24">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 grid grid-cols-1 md:grid-cols-2 gap-8 md:gap-12 items-center md:items-start">
    <!-- Text content -->
    <div class="space-y-6 md:space-y-8 flex flex-col items-start order-2 md:order-1 mt-2 md:mt-0">
      
      {lang === 'en' ? (
        <Fragment>
          <h1 class="text-4xl md:text-5xl lg:text-6xl xl:text-7xl font-heading font-extrabold leading-[1.1] text-primary">
            Build <span class="text-transparent bg-clip-text bg-gradient-to-r from-cta to-dark">Passive&nbsp;Income </span> <br class="hidden lg:block"/>
            Successfully with <br class="hidden lg:block"/>
            Analía Camarda
          </h1>
          <p class="font-outfit text-lg md:text-xl text-dark text-justify max-w-lg leading-relaxed">
            Expand your skills, increase your income, and conquer a new digital market using the exact blueprints that gave me financial freedom.
          </p>
        </Fragment>
      ) : (
        <Fragment>
          <h1 class="text-4xl md:text-5xl lg:text-6xl xl:text-7xl font-heading font-extrabold leading-[1.1] text-primary">
            Construye <br class="hidden lg:block"/>
            <span class="text-transparent bg-clip-text bg-gradient-to-r from-cta to-dark">Ingresos Pasivos</span> <br class="hidden lg:block"/>
            Exitosamente&nbsp;con <br class="hidden lg:block"/>
            Analía Camarda
          </h1>
          <p class="font-outfit text-lg md:text-xl text-dark text-justify max-w-lg leading-relaxed">
            Expande tus habilidades, aumenta tus ingresos y conquista un nuevo mercado digital utilizando las exactas hojas de ruta que me dieron libertad financiera.
          </p> 
        </Fragment>
      )}
      
      <div class="font-outfit flex flex-col md:flex-row gap-4 pt-1 w-full md:w-auto">
        <a href="https://skool.com/deafdigitalpro" target="_blank" rel="noopener noreferrer" onclick="if(window.trackEvent)window.trackEvent('click_academy','cta','hero_button',1)" class="inline-flex justify-center items-center gap-2 bg-gradient-to-r from-cta to-cta-hover text-white px-6 py-4 rounded-lg transition-all shadow-md whitespace-nowrap text-center">
          {lang === 'en' ? 'Join the Academy ↗' : 'Únete a la Academia ↗'}
        </a>
        <a href="#books" onclick="if(window.trackEvent)window.trackEvent('click_books','cta','hero_button',1)" class="inline-flex justify-center items-center gap-2 text-primary px-6 py-4 rounded-lg transition-all border border-primary/20 bg-card/50 whitespace-nowrap text-center">
  {lang === 'en' ? 'See My Books' : 'Ver mis Libros'}
</a>
      </div>
      
      <!-- Trust indicators -->
      <div class="font-outfit flex items-center gap-4 text-xl tracking-wide text-dark/70">
        <span class="uppercase">
          {lang === 'en' ? 'Trusted by 9k+ on Instagram' : 'Con la confianza de 9k+ en Instagram'}
        </span>
      </div>
    </div>
    
    <!-- Hero Image -->
    <div class="relative w-full flex justify-center items-end order-1 md:order-2 mt-8 md:mt-0">
      <!-- Glow effect -->
      <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-full h-full bg-primary/10 blur-[60px] md:blur-[100px] rounded-full pointer-events-none"></div>
      
      <!-- Floating badges: Ajustados para que no se encimen tanto -->
      <div class="absolute left-0 bottom-10 md:bottom-1/3 inline-flex items-center gap-2 px-3 py-2 rounded-full border border-primary/20 bg-background/80 backdrop-blur-md text-[10px] md:text-xs font-bold text-primary shadow-xl z-20">
        <span class="text-cta">✦</span> {lang === 'en' ? 'Made for Beginners' : 'Hecho para Principiantes'}
      </div>
      
      <div class="absolute right-0 bottom-20 md:bottom-1/4 inline-flex items-center gap-2 px-3 py-2 rounded-full border border-primary/20 bg-background/80 backdrop-blur-md text-[10px] md:text-xs font-bold text-primary shadow-xl z-20">
        <span class="text-cta">✦</span> {lang === 'en' ? 'Highly requested skills' : 'Habilidades de Alta Demanda'}
      </div>
      
      <!-- Contenedor de imagen: Eliminado el md:w-1/2 para que fluya con el grid -->
      <div class="relative z-10 w-full max-w-[300px] md:max-w-md aspect-[3/4] rounded-t-full bg-gradient-to-b from-card to-transparent border-t border-x border-primary/20 overflow-hidden flex items-end justify-center shadow-2xl">
          <!-- Modifica este scr para cambiar la imagen del Hero -->
          <Image src={heroImg} alt="Analía Camarda" class="w-full h-auto object-contain transition-all duration-700 hover:scale-105" loading="eager" />
      </div>
    </div>
  </div>
</section>
