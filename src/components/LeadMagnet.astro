---
export interface Props {
  lang: 'en' | 'es';
}
const { lang } = Astro.props;
---

<!-- LEAD MAGNET / PRE-FOOTER CTA -->
<section id="newsletter" class="bg-background text-primary py-12 md:py-24 border-y border-primary/20">
  <div class="max-w-3xl mx-auto px-4 text-center space-y-8">
    <h2 class="text-3xl md:text-4xl lg:text-5xl font-heading font-bold leading-tight text-primary">
      {lang === 'en'
        ? 'Free Guide: 5 Passive Income Streams You Can Start Today'
        : 'Guía Gratis: 5 Fuentes de Ingresos Pasivos que Puedes Iniciar Hoy'}
    </h2>
    <p class="font-outfit text-base md:text-lg text-dark/80 leading-relaxed">
      {lang === 'en'
        ? 'Enter your email to instantly receive a PDF with my personal blueprint for designing an independent life.'
        : 'Ingresa tu email y recibe al instante un PDF con mi blueprint personal para diseñar una vida independiente.'}
    </p>

    <!-- Integración con Fetch API -->
    <div class="bg-card p-2 rounded-xl max-w-lg mx-auto flex shadow-xl border border-primary/20 focus-within:ring-4 focus-within:ring-primary/20 transition-all" id="lead-container">
      <form id="lead-form" class="flex w-full relative" data-lang={lang}>
        <label for={lang === 'en' ? 'email-en' : 'email-es'} class="sr-only">
          {lang === 'en' ? 'Email address' : 'Correo electrónico'}
        </label>
        <input
          type="email"
          id={lang === 'en' ? 'email-en' : 'email-es'}
          name="email"
          aria-label={lang === 'en' ? 'Your email address' : 'Tu correo electrónico'}
          placeholder={lang === 'en' ? 'Email access...' : 'Tu correo...'}
          class="w-full px-4 rounded-l-lg bg-transparent text-dark font-medium outline-none"
          required
        />
        <button type="submit" id="lead-submit-btn" class="bg-primary hover:bg-dark text-white px-6 py-4 rounded-lg font-bold transition-colors whitespace-nowrap">
          <span id="btn-text">{lang === 'en' ? 'Get PDF' : 'Obtener PDF'}</span>
          <span id="btn-loader" class="hidden">↻</span>
        </button>
      </form>
    </div>

    <!-- Mensaje de éxito (oculto por defecto) -->
    <div id="lead-success" class="hidden items-center justify-center space-y-2 mt-4 text-primary">
      <p class="font-outfit text-lg font-bold">✅ {lang === 'en' ? 'Success! Check your Email. We sent you the PDF.' : '¡Éxito! Revisa tu Correo. Te hemos enviado el PDF.'}</p>
    </div>

    <!-- Mensaje de error (oculto por defecto) -->
    <div id="lead-error" class="hidden mt-4 font-outfit text-sm text-red-500">
      <p id="lead-error-msg"></p>
    </div>
  </div>
</section>

<script>
  const form       = document.getElementById('lead-form') as HTMLFormElement;
  const container  = document.getElementById('lead-container');
  const successMsg = document.getElementById('lead-success');
  const errorDiv   = document.getElementById('lead-error');
  const errorMsg   = document.getElementById('lead-error-msg');
  const submitBtn  = document.getElementById('lead-submit-btn') as HTMLButtonElement;
  const btnText    = document.getElementById('btn-text');
  const btnLoader  = document.getElementById('btn-loader');

  // Función auxiliar para mostrar error inline
  const showError = (msg: string) => {
    if (errorMsg) errorMsg.textContent = msg;
    if (errorDiv) errorDiv.classList.remove('hidden');
  };

  if (form) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      // Ocultar error previo si existe
      if (errorDiv) errorDiv.classList.add('hidden');

      // Mostrar estado de carga
      submitBtn.disabled = true;
      submitBtn.classList.add('opacity-80', 'cursor-not-allowed');
      btnText?.classList.add('hidden');
      btnLoader?.classList.remove('hidden');

      const formData = new FormData(form);
      const email    = formData.get('email');
      const lang     = form.getAttribute('data-lang');

      // Rastreo de evento en Google Analytics
      if ((window as any).trackEvent) {
        (window as any).trackEvent('submit_lead_magnet', 'lead_generation', 'email_form', 1);
      }

      try {
        const response = await fetch('/api/leads', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email, lang }),
        });

        if (response.ok) {
          // Ocultar formulario y mostrar mensaje de éxito
          if (container) container.style.display = 'none';
          if (successMsg) {
            successMsg.classList.remove('hidden');
            successMsg.classList.add('flex');
          }
        } else {
          showError(lang === 'en' ? 'An error occurred. Try again.' : 'Hubo un error. Inténtalo de nuevo.');
        }
      } catch (err) {
        showError(lang === 'en' ? 'Network error. Try again.' : 'Error de red. Inténtalo de nuevo.');
      } finally {
        // Restaurar botón siempre
        submitBtn.disabled = false;
        submitBtn.classList.remove('opacity-80', 'cursor-not-allowed');
        btnText?.classList.remove('hidden');
        btnLoader?.classList.add('hidden');
      }
    });
  }
</script>