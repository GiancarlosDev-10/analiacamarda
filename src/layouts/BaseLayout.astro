---
import SEO from '../components/SEO.astro';
import Analytics from '../components/Analytics.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import '../styles/global.css';
import { getImage } from 'astro:assets';
import heroImg from '../assets/images/foto-hero.png';

export interface Props {
  title: string;
  description: string;
  image?: string;
  schema?: string;
  lang?: "en" | "es";
  preloadHero?: boolean;
}

const { title, description, image, schema, lang = "en", preloadHero = false } = Astro.props;
const currentPath = Astro.url.pathname;

let heroSrcset: string | undefined;
if (preloadHero) {
  const [hero300, hero520] = await Promise.all([
    getImage({ src: heroImg, width: 300, format: 'webp' }),
    getImage({ src: heroImg, width: 520, format: 'webp' }),
  ]);
  heroSrcset = `${hero300.src} 300w, ${hero520.src} 520w`;
}
---
<!DOCTYPE html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    
    {heroSrcset && (
      <link rel="preload" as="image" imagesrcset={heroSrcset} imagesizes="(max-width: 768px) 300px, 520px" fetchpriority="high" />
    )}
    <SEO title={title} description={description} image={image} schema={schema} lang={lang} canonical={Astro.url.href}/>
    <Analytics />
  </head>
  <body class="bg-background text-dark font-body min-h-screen flex flex-col antialiased relative">
    <Header currentPath={currentPath} />
    <main class="flex-grow flex flex-col w-full">
      <slot />
    </main>
    <Footer />
    <WhatsAppButton lang={lang} />
  </body>
</html>