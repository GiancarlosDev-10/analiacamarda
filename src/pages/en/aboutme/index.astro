---
import { Image } from 'astro:assets';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import portraitImg from '../../../assets/images/mihistoria.png';

const schema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Person",
  "name": "Analía Camarda",
  "url": "https://www.analiacamarda.com",
  "jobTitle": "Digital Entrepreneur",
  "alumniOf": "Cybersecurity & Data Analytics",
  "description": "Deaf digital entrepreneur, Miss Deaf Argentina, and passive income expert based in the US.",
  "sameAs": [
  "https://instagram.com/deafdigitalpro/",
  "https://linkedin.com/in/analia-camarda-2b4152102/",
  "https://tiktok.com/@academydigital1",
  "https://skool.com/deafdigitalpro"
]
});
---

<BaseLayout
  title="My Story | Analía Camarda"
  description="Discover the journey of Analía Camarda: from Miss Deaf Argentina and Cybersecurity grad to building a profitable passive income digital business."
  schema={schema}
  lang="en"
  image="/images/og-default.png"
>

  <!-- HERO HEADER -->
  <section class="relative bg-background pt-16 pb-10 border-b border-primary/10 overflow-hidden">
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 pointer-events-none z-0">
      <p class="text-[14vw] font-heading font-black text-primary/5 tracking-widest whitespace-nowrap select-none">
        MY STORY
      </p>
    </div>
    <div class="max-w-4xl mx-auto px-4 text-center relative z-10 space-y-4">
      <div class="font-outfit flex justify-center items-center gap-2 text-cta text-md tracking-widest uppercase">
        <span>✦</span> Learn from an Expert
      </div>
      <h1 class="text-5xl md:text-6xl font-heading font-extrabold text-primary leading-tight">
        Hello, I'm Analía!
      </h1>
      <p class="font-outfit text-base md:text-lg text-dark/70 max-w-2xl mx-auto leading-relaxed">
        An immigrant, a tech graduate, a beauty queen, and an advocate for the deaf community fighting for financial inclusion.
      </p>
    </div>
  </section>

  <!-- MAIN CONTENT -->
  <section class="bg-background py-24">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 space-y-20">

      <!-- Portrait image -->
      <div class="aspect-[16/9] w-full bg-card rounded-2xl border border-primary/20 shadow-2xl overflow-hidden">
        <Image
          src={portraitImg}
          alt="Analia Camarda"
          class="w-full h-full object-cover"
          loading="eager"
        />
      </div>

      <!-- Story sections -->
      <div class="space-y-16">

        <!-- Section 1 -->
        <div class="grid md:grid-cols-2 gap-12 items-start">
          <div>
            <div class="font-outfit flex items-center gap-2 text-cta text-sm tracking-widest uppercase mb-4">
              <span>✦</span> My Journey
            </div>
            <h2 class="text-3xl font-heading font-bold text-primary mb-6">Born deaf, built unstoppable.</h2>
          </div>
          <div class="space-y-4 font-outfit text-lg text-dark/80 leading-relaxed text-justify">
            <p>Born in Argentina, I lost my hearing at age three to a severe Otitis infection. Early challenges in education fueled my passion for logic and problem-solving, leading to a degree in<strong class="text-primary font-bold"> Cybersecurity and Data Analytics</strong>.</p>
            <p>Miss Deaf Argentina — global advocate for Deaf capabilities worldwide, championing the dreams and potential of <strong class="text-primary font-bold">deaf people across every border</strong>.</p>
          </div>
        </div>

        <!-- Divider -->
        <div class="border-t border-primary/10"></div>

        <!-- Section 3 -->
        <div class="grid md:grid-cols-2 gap-12 items-start">
          <div>
            <div class="font-outfit flex items-center gap-2 text-cta text-sm tracking-widest uppercase mb-4">
              <span>✦</span> The Turning Point
            </div>
            <h2 class="text-3xl font-heading font-bold text-primary mb-6">I built my own ecosystem.</h2>
          </div>
          <div class="space-y-4 font-outfit text-lg text-dark/80 leading-relaxed text-justify">
            <p>Rather than waiting for change, I built my own path — digital products, e-books, and automated systems that work 24/7, <strong class="text-primary font-bold">silently in the background</strong>.</p>
            <p>No phone calls. No noise. <strong class="text-primary font-bold">Just results.</strong>.</p>
          </div>
        </div>

        <!-- Divider -->
        <div class="border-t border-primary/10"></div>

        <!-- Section 4 -->
        <div class="grid md:grid-cols-2 gap-12 items-start">
          <div>
            <div class="font-outfit flex items-center gap-2 text-cta text-sm tracking-widest uppercase mb-4">
              <span>✦</span> My Mission
            </div>
            <h2 class="text-3xl font-heading font-bold text-primary mb-6">Now, my mission is you.</h2>
          </div>
          <div class="space-y-4 font-outfit text-lg text-dark/80 leading-relaxed text-justify">
            <p>Passive income changed my life — financial independence, global reach, freedom on my own terms.

Now I want to pass you the exact blueprints. Through the Digital Academy or my e-book library, I equip the Deaf and Spanish-speaking community worldwide with the same systems I use every day.</p>
            <p class="text-primary font-bold">"Because your voice doesn't need to be heard to build an extraordinary life."</p>
          </div>
        </div>

      </div>

      <!-- CTA -->
      <div class="pt-8 border-t border-primary/20 text-center space-y-6">
        <h3 class="text-3xl font-heading font-bold text-primary">Let's build your freedom</h3>
        <a href="/en/books" onclick="if(window.trackEvent)window.trackEvent('click_explore_books','cta','about_me',1)" class="inline-block bg-cta hover:bg-dark text-white px-10 py-4 rounded-full font-outfit transition-all shadow-lg hover:shadow-xl text-md">
          Explore My Books
        </a>
      </div>

    </div>
  </section>

</BaseLayout>
