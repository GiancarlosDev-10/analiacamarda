---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import logoVerde from '../../../assets/images/logo_verde.png';
import teamworkIcon from '../../../assets/images/teamwork.svg?url';

const schema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Course",
  name: "Deaf Digital Pro Academy",
  description:
    "An interactive Skool community designed to teach passive income generation through dedicated blueprints, and weekly mentoring.",
  provider: {
    "@type": "Person",
    name: "Analía Camarda",
    url: "https://www.analiacamarda.com",
  },
});
---

<BaseLayout
  title="Digital Academy | Analía Camarda"
  description="Join the Deaf Digital Pro Academy on Skool. Access unlimited classes, e-books, live sessions and personalized mentorship for $9/month."
  schema={schema}
  lang="en"
  image="/images/og-default.png"
>
  <!-- HERO HEADER -->
  <section
    class="relative bg-background pt-16 pb-10 border-b border-primary/10 overflow-hidden"
  >
    <div
      class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 pointer-events-none z-0"
    >
      <p
        class="text-[16vw] font-heading font-black text-primary/5 tracking-widest whitespace-nowrap select-none"
      >
        ACADEMY
      </p>
    </div>

    <div class="max-w-4xl mx-auto px-4 text-center relative z-10 space-y-4">
      <div
        class="font-outfit flex justify-center items-center gap-2 text-cta text-md tracking-widest uppercase"
      >
        <span>✦</span> The Community
      </div>
      <h1
        class="text-4xl md:text-6xl font-heading font-extrabold text-primary leading-tight"
      >
        Digital Academy
      </h1>
      <p
        class="font-outfit text-base md:text-lg text-dark/70 max-w-2xl mx-auto leading-relaxed"
      >
        Where entrepreneurs come together to achieve automated financial
        independence. Get full access to all classes, e-books, live sessions and
        personalized mentorship.
      </p>
    </div>
  </section>

  <!-- PRICING SECTION -->
  <section class="bg-background py-16">
    <div class="max-w-5xl mx-auto px-4">
      <div class="flex md:grid md:grid-cols-2 gap-8 items-start overflow-x-auto md:overflow-visible snap-x snap-mandatory scroll-pl-4 md:scroll-pl-0 pb-6 md:pb-0">
        <!-- SPECIAL OFFER CARD -->
        <div class="group relative bg-card rounded-2xl border border-primary/15 px-6 pt-5 pb-8 md:px-12 md:pt-8 md:pb-12 flex flex-col shadow-xl hover:scale-103 transition-all duration-500 hover:bg-primary overflow-hidden w-[calc(100%-2rem)] snap-center md:min-w-0 flex-shrink-0 mx-2">
          <div class="absolute -top-1 -left-1 overflow-hidden w-40 h-40 pointer-events-none z-20">
            <div class="absolute top-7 -left-18 w-58 py-2 bg-[#D4AF37] text-black text-[11px] font-bold text-center transform -rotate-45 shadow-lg uppercase tracking-widest border-y border-white/20">
              Special Offer
            </div>
          </div>

          <div
            class="font-outfit flex items-center gap-2 text-cta text-sm tracking-widest uppercase mb-2 group-hover:text-white transition-colors"
          >
            <span>✦</span> Premium
          </div>
          <div class="mb-8">
            <div class="text-5xl md:text-6xl font-heading font-extrabold text-primary group-hover:text-white transition-colors">
              $29<span class="text-2xl md:text-3xl font-normal text-dark/60 group-hover:text-white/80 transition-colors">/month</span>
            </div>
            <p class="font-outfit text-sm text-dark/50 mt-3 mb-[-16px] group-hover:text-white/70 transition-colors">Everything you need to build a real digital income:</p>
          </div>
          <ul class="space-y-4 mb-8 font-outfit text-dark/90 group-hover:text-white transition-colors">
             <li class="flex items-start mb-1 gap-3">
              <div class="flex gap-1 mt-1 group-hover:text-white/90 transition-colors">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-4 h-4 text-cta">
                  <path fill-rule="evenodd" d="M10.788 3.21c.448-1.077 1.976-1.077 2.424 0l2.082 5.007 5.404.433c1.164.093 1.636 1.545.749 2.305l-4.117 3.527 1.257 5.273c.271 1.136-.964 2.033-1.96 1.425L12 18.354 7.373 21.18c-.996.608-2.231-.29-1.96-1.425l1.257-5.273-4.117-3.527c-.887-.76-.415-2.212.749-2.305l5.404-.433 2.082-5.006z" clip-rule="evenodd" />
                </svg>
              </div>
              <span class="text-base">Digital Freedom — complete system</span>
            </li>
            <li class="flex items-start mb-1 gap-3">
              <div
                class="flex gap-1 mt-1 group-hover:text-white/90 transition-colors"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  fill="currentColor"
                  class="w-4 h-4 text-cta"
                >
                  <path
                    fill-rule="evenodd"
                    d="M10.788 3.21c.448-1.077 1.976-1.077 2.424 0l2.082 5.007 5.404.433c1.164.093 1.636 1.545.749 2.305l-4.117 3.527 1.257 5.273c.271 1.136-.964 2.033-1.96 1.425L12 18.354 7.373 21.18c-.996.608-2.231-.29-1.96-1.425l1.257-5.273-4.117-3.527c-.887-.76-.415-2.212.749-2.305l5.404-.433 2.082-5.006z"
                    clip-rule="evenodd"></path>
                </svg>
              </div>
              <span class="text-base"> 2 e-Books included</span>
            </li>
            <li class="flex items-start mb-1 gap-3">
              <span class="text-green-500 mt-0.5 group-hover:text-green-300 transition-colors">✓</span>
              <span class="text-base">E-commerce from Scratch</span>
            </li>
            <li class="flex items-start mb-1 gap-3">
              <span
                class="text-green-500 mt-0.5 group-hover:text-green-300 transition-colors"
                >✓</span
              >
              <span class="text-base">Mega Digital Marketing</span>
            </li>
            <li class="flex items-start mb-1 gap-3">
              <span
                class="text-green-500 mt-0.5 group-hover:text-green-300 transition-colors"
                >✓</span
              >
              <span class="text-base">AI for Entrepreneurs</span>
            </li>
            <li class="flex items-start mb-1 gap-3">
              <span
                class="text-green-500 mt-0.5 group-hover:text-green-300 transition-colors"
                >✓</span
              >
              <span class="text-base">Private community Access</span>
            </li>
            <li class="flex items-start mb-1 gap-3">
              <span
                class="text-green-500 mt-0.5 group-hover:text-green-300 transition-colors"
