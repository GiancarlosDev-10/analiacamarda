          >
            Secure payment via Stripe · SSL Encrypted
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- TESTIMONIALS -->
  <section class="bg-background py-2">
    <div class="max-w-6xl mx-auto px-4 space-y-10">
      <div class="flex flex-col items-center gap-4 text-center">
        <a href="#testimonials" class="inline-flex items-center gap-3 rounded-full border border-primary/20 bg-white px-6 py-3 text-primary shadow-lg transition hover:-translate-y-0.5 hover:shadow-xl font-outfit">
          <img src={teamworkIcon} alt="Teamwork" class="h-6 w-6" />
          <span class="font-bold text-sm uppercase tracking-[0.2em]">Real student stories</span>
        </a>
        <p class="max-w-3xl text-sm md:text-base text-dark/70 leading-relaxed font-outfit">
          Meet real entrepreneurs who moved forward with the Digital Academy: mentoring, e-books, live sessions, and a community that supports every step.
