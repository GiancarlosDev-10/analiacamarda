                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  fill="currentColor"
                  class="w-4 h-4 text-cta"
                >
                  <path
                    fill-rule="evenodd"
                    d="M12 1.5a5.25 5.25 0 00-5.25 5.25v3a3 3 0 00-3 3v6.75a3 3 0 003 3h10.5a3 3 0 003-3v-6.75a3 3 0 00-3-3v-3c0-2.9-2.35-5.25-5.25-5.25zm3.75 8.25v-3a3.75 3.75 0 10-7.5 0v3h7.5z"
                    clip-rule="evenodd"></path>
                </svg>
              </div>
              <span class="text-base">VIP Cybersecurity & Data Analytics bootcamps locked</span>
            </li>
          </ul>

          <a
            href="https://buy.stripe.com/aFafZhd4i0H10Xlfm13ZK05"
            target="_blank"
            rel="noopener noreferrer"
            onclick={`if(window.trackEvent)window.trackEvent('click_academy_premium','purchase','academy-en',9)`}
            class="w-full bg-cta hover:bg-cta-hover text-white text-center px-6 py-4 rounded-xl font-bold font-outfit text-lg transition-all shadow-lg hover:shadow-xl transform active:scale-95"
