          Start $ 9 USD / Month  
          </a>
          <p
            class="font-outfit text-xs text-dark/40 text-center mt-4 group-hover:text-white/60 transition-colors"
          >
            Secure payment via Stripe · SSL Encrypted
          </p>
        </div>

        <!-- EXCLUSIVE FOR VIP MEMBERS CARD -->
        <div class="group relative bg-card rounded-2xl border border-primary/15 px-6 pt-5 pb-8 md:px-12 md:pt-8 md:pb-12 flex flex-col shadow-xl hover:scale-103 transition-all duration-500 hover:bg-primary overflow-hidden w-[calc(100%-2rem)] snap-center md:min-w-0 flex-shrink-0 mx-2">
          <div class="absolute -top-1 -left-1 overflow-hidden w-40 h-40 pointer-events-none z-20">
            <div class="absolute top-6 -left-14 w-50 py-2 bg-[#D4AF37] text-black text-[10px] font-bold text-center transform -rotate-45 shadow-lg uppercase tracking-widest border-y border-white/20">
              Exclusive for <p>VIP Members
            </div>
          </div>

            <div class="font-outfit flex items-center gap-2 text-cta text-sm tracking-widest uppercase mb-2 group-hover:text-white transition-colors">
              <span>✦✦</span>CyberSecurity and Data Analyst
            </div>
          <div class="mb-8">
            <div class="text-5xl md:text-6xl font-heading font-extrabold text-primary group-hover:text-white transition-colors">
              $29<span class="text-2xl md:text-3xl font-normal text-dark/60 group-hover:text-white/80 transition-colors">/month</span>
            </div>
            <p class="font-outfit text-sm text-dark/50 mt-3 mb-[-16px] group-hover:text-white/70 transition-colors">Everything in Premium, plus:</p>
          </div>
          <ul class="space-y-4 mb-8 font-outfit text-dark/90 group-hover:text-white transition-colors">
             <li class="flex items-start mb-1 gap-3">
              <div class="flex gap-1 mt-1 group-hover:text-white/90 transition-colors">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-4 h-4 text-cta">
                  <path fill-rule="evenodd" d="M10.788 3.21c.448-1.077 1.976-1.077 2.424 0l2.082 5.007 5.404.433c1.164.093 1.636 1.545.749 2.305l-4.117 3.527 1.257 5.273c.271 1.136-.964 2.033-1.96 1.425L12 18.354 7.373 21.18c-.996.608-2.231-.29-1.96-1.425l1.257-5.273-4.117-3.527c-.887-.76-.415-2.212.749-2.305l5.404-.433 2.082-5.006z" clip-rule="evenodd" />
                </svg>
              </div>
              <span class="text-base">Cybersecurity Bootcamp modules</span>
            </li>

            <li class="flex items-start mb-1 gap-3">
              <div
                class="flex gap-1 mt-1 group-hover:text-white/90 transition-colors"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  fill="currentColor"
                  class="w-4 h-4 text-cta"
                >
                  <path
                    fill-rule="evenodd"
                    d="M10.788 3.21c.448-1.077 1.976-1.077 2.424 0l2.082 5.007 5.404.433c1.164.093 1.636 1.545.749 2.305l-4.117 3.527 1.257 5.273c.271 1.136-.964 2.033-1.96 1.425L12 18.354 7.373 21.18c-.996.608-2.231-.29-1.96-1.425l1.257-5.273-4.117-3.527c-.887-.76-.415-2.212.749-2.305l5.404-.433 2.082-5.006z"
                    clip-rule="evenodd"></path>
                </svg>
              </div>
              <span class="text-base">Live Class — Analía + expert guests</span>
            </li>

            <li class="flex items-start mb-1 gap-3">
              <div
                class="flex gap-1 mt-1 group-hover:text-white/90 transition-colors"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  fill="currentColor"
                  class="w-4 h-4 text-cta"
                >
                  <path
                    fill-rule="evenodd"
                    d="M10.788 3.21c.448-1.077 1.976-1.077 2.424 0l2.082 5.007 5.404.433c1.164.093 1.636 1.545.749 2.305l-4.117 3.527 1.257 5.273c.271 1.136-.964 2.033-1.96 1.425L12 18.354 7.373 21.18c-.996.608-2.231-.29-1.96-1.425l1.257-5.273-4.117-3.527c-.887-.76-.415-2.212.749-2.305l5.404-.433 2.082-5.006z"
                    clip-rule="evenodd"></path>
                </svg>
              </div>
              <span class="text-base">Certificate of completion</span>
            </li>
            <li class="flex items-start mb-1 gap-3">
              <span
                class="text-green-500 mt-0.5 group-hover:text-green-300 transition-colors"
                >✓</span
              >
              <span class="text-base">Ethical hacking basics</span>
            </li>
            <li class="flex items-start mb-1 gap-3">
              <span
