---
import { Image } from 'astro:assets';
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import booksData from '../../../data/books.json';
import { resolveImage } from '../../../utils/images';

export async function getStaticPaths() {
  // Filtrar posts con draft: true para que no se publiquen
  const blogEntries = await getCollection('blog', ({ data }) => !data.draft);
  return blogEntries.map(entry => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const relatedBook = booksData.find(b => b.slug === entry.data.relatedBookSlug);

const schema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": entry.data.title,
  "description": entry.data.description,
  "image": entry.data.image ? `https://www.analiacamarda.com${entry.data.image}` : undefined,
  "author": {
    "@type": "Person",
    "name": "Analía Camarda"
  },
  "datePublished": entry.data.date.toISOString(),
});

// Resolver imagen del libro relacionado
const relatedBookImage = relatedBook ? await resolveImage(relatedBook.coverImage) : null;
---

<BaseLayout
  title={`${entry.data.title} | Blog | Analía Camarda`}
  description={entry.data.description}
  image={entry.data.image ?? "/images/og-default.png"}
  schema={schema}
  lang="en"
>
  <article class="bg-card pt-8 pb-10 min-h-screen">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">

      <header class="mb-4 text-center space-y-2">
        <span class="text-cta font-outfit tracking-widest uppercase text-sm">✦ {entry.data.category}</span>
        <h1 class="text-4xl md:text-5xl pb-4 font-heading font-extrabold text-primary leading-tight">
          {entry.data.title}
        </h1>
        <p class="font-outfit text-xl text-dark/70">
          {entry.data.description}
        </p>
        <time class="block text-sm text-dark/50" datetime={entry.data.date.toISOString()}>
          {entry.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
        </time>
      </header>

      <!-- Contenido Markdown compilado -->
      <div class="prose prose-lg prose-headings:font-heading prose-headings:text-primary prose-p:text-dark prose-p:font-outfit text-justify prose-p:text-justify prose-p:mt-0 prose-a:text-cta hover:prose-a:text-cta-hover max-w-none">
        <Content />
      </div>
      <hr class="my-16 border-primary/20" />

      <!-- Sección de interacción: Estrellas y compartir -->
      <div class="mt-16 pt-8 border-t-2 border-primary/5 flex flex-col md:flex-row items-center justify-between gap-8">

        <!-- Calificación con estrellas -->
        <div class="flex flex-col items-center md:items-start gap-3">
          <span class="text-sm font-bold font-outfit uppercase tracking-widest text-dark/40">Rate this article</span>
          <div id="star-rating" class="flex items-center gap-1">
            {[1, 2, 3, 4, 5].map((star) => (
              <button
                class="star-btn text-3xl transition-all duration-300 hover:scale-125 focus:outline-none text-dark/10"
                data-star={star}
                title={`Rate ${star} stars`}
              >
                ★
              </button>
            ))}
          </div>
          <p id="rating-status" class="text-xs font-medium text-cta/70 italic min-h-[1rem]"></p>
        </div>

        <!-- Botones para compartir -->
        <div class="flex flex-col items-center md:items-end gap-3">
          <span class="text-sm font-bold font-outfit uppercase tracking-widest text-dark/40">Share with the world</span>
          <div class="flex items-center gap-4">
            <!-- WhatsApp -->
            <a
              href={`https://wa.me/?text=${encodeURIComponent(entry.data.title + ' - https://analiacamarda.com/en/blog/' + entry.id)}`}
              target="_blank"
              rel="noopener noreferrer"
              class="w-10 h-10 flex items-center justify-center bg-[#25D366] text-white rounded-full hover:scale-110 transition-transform shadow-lg"
              title="Share on WhatsApp"
            >
              <svg class="w-6 h-6 fill-current" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
            </a>
            <!-- X (Twitter) -->
            <a
              href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(entry.data.title)}&url=${encodeURIComponent('https://analiacamarda.com/en/blog/' + entry.id)}`}
              target="_blank"
              rel="noopener noreferrer"
              class="w-10 h-10 flex items-center justify-center bg-black text-white rounded-full hover:scale-110 transition-transform shadow-lg"
              title="Share on X"
            >
              <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
            </a>
            <!-- LinkedIn -->
            <a
              href={`https://www.linkedin.com/shareArticle?mini=true&url=${encodeURIComponent('https://analiacamarda.com/en/blog/' + entry.id)}`}
              target="_blank"
              rel="noopener noreferrer"
              class="w-10 h-10 flex items-center justify-center bg-[#0077b5] text-white rounded-full hover:scale-110 transition-transform shadow-lg"
              title="Share on LinkedIn"
            >
              <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/></svg>
            </a>
          </div>
        </div>
      </div>

      <hr class="my-16 border-primary/20" />

      <!-- Sección de comentarios (Cusdis) -->
      <div id="comments" class="pt-16 border-t border-primary/20">
        <div class="max-w-2xl mx-auto">
          <div class="text-center space-y-2 mb-10">
            <h3 class="text-3xl font-heading font-bold text-primary">Conversation</h3>
            <p class="font-outfit text-dark/50 text-sm tracking-wider uppercase">Speak your mind • Share your thoughts</p>
          </div>
          <div class="bg-card rounded-3xl p-1 shadow-sm border border-primary/10">
            <div
              id="cusdis_thread"
              class="px-4 py-8"
              data-host="https://cusdis.com"
              data-app-id="00000000-0000-0000-0000-000000000000"
              data-page-id={entry.id}
              data-page-url={`https://analiacamarda.com/en/blog/${entry.id}`}
              data-page-title={entry.data.title}
            ></div>
          </div>
          <!-- Pendiente: reemplazar data-app-id con el ID real de Cusdis al configurar la cuenta -->
          <script async defer src="https://cusdis.com/js/cusdis.es.js"></script>
        </div>
      </div>

      <hr class="my-16 border-primary/20" />

      <!-- CTA Academia y Libro relacionado -->
      <div class="bg-card border border-primary/20 rounded-2xl p-8 shadow-xl flex flex-col md:flex-row items-center gap-8">
        {relatedBook && relatedBookImage && (
          <div class="flex-shrink-0">
            <Image src={relatedBookImage} alt={relatedBook.title} class="w-32 shadow-md rounded-md border border-primary/10" loading="lazy" />
          </div>
        )}
        <div class="space-y-4">
          <h3 class="text-2xl font-heading font-bold text-primary">Ready to take the next step?</h3>
          <p class="text-dark/80 font-medium">
            If you found this article helpful, you'll love the deep dive in my comprehensive blueprints and the community support at Skool.
          </p>
          <div class="flex flex-wrap gap-4 pt-4">
            <a
              href="https://skool.com/deafdigitalpro"
              target="_blank"
              rel="noopener noreferrer"
              class="bg-cta hover:bg-cta-hover text-white px-6 py-3 rounded-lg font-bold shadow-lg transition-colors"
            >
              Join Academy Free
            </a>
            {relatedBook && (
              <a
                href={`/en/books/${relatedBook.slug}`}
                class="bg-transparent border border-primary/30 hover:bg-primary/5 text-primary px-6 py-3 rounded-lg font-bold transition-colors"
              >
                Get {relatedBook.title}
              </a>
            )}
          </div>
        </div>
      </div>

    </div>
  </article>
</BaseLayout>

<script>
  // Sistema de calificación local con localStorage
  const setupRating = () => {
    const pathParts = window.location.pathname.split('/').filter(p => p && p !== 'en' && p !== 'blog');
    const postId = pathParts[0] || 'index';

    const starBtns = document.querySelectorAll('.star-btn');
    const statusEl = document.getElementById('rating-status');

    if (starBtns.length === 0) return;

    const updateStars = (rating: number) => {
      starBtns.forEach((btn, idx) => {
        if (idx < rating) {
          btn.classList.add('text-cta');
          btn.classList.remove('text-dark/10');
        } else {
          btn.classList.remove('text-cta');
          btn.classList.add('text-dark/10');
        }
      });
    };

    // Cargar calificación guardada
    const savedRating = localStorage.getItem(`rating_${postId}`);
    if (savedRating) {
      updateStars(parseInt(savedRating));
      if (statusEl) statusEl.textContent = 'Thanks for your feedback!';
    }

    starBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const rating = parseInt(btn.getAttribute('data-star') || '0');
        localStorage.setItem(`rating_${postId}`, rating.toString());
        updateStars(rating);
        if (statusEl) {
          statusEl.textContent = 'Rating saved. Thank you!';
          statusEl.classList.add('animate-pulse');
        }
      });

      btn.addEventListener('mouseenter', () => {
        const rating = parseInt(btn.getAttribute('data-star') || '0');
        updateStars(rating);
      });

      btn.addEventListener('mouseleave', () => {
        const current = parseInt(localStorage.getItem(`rating_${postId}`) || '0');
        updateStars(current);
      });
    });
  };

  // Inicializar
  setupRating();

  // Soporte para View Transitions de Astro
  document.addEventListener('astro:after-swap', setupRating);
</script>