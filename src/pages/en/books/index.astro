---
import { Image } from 'astro:assets';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import booksData from '../../../data/books.json';
import { resolveImage } from '../../../utils/images';

const englishBooks = await Promise.all(
  booksData
    .filter(b => b.lang === 'en')
    .map(async (book) => {
      try {
        const imageAsset = await resolveImage(book.coverImage);
        return { ...book, imageAsset };
      } catch (e) {
        console.error(e);
        return { ...book, imageAsset: null };
      }
    })
);
---

<BaseLayout
  title="All E-Books Library | Analía Camarda"
  description="Explore Analía Camarda's full library of e-books to help you build passive income, start an online business, and master digital marketing."
  image="/images/og-default.png"
  lang="en"
>
  <!-- HERO HEADER -->
  <section class="relative bg-background pt-16 pb-10 border-b border-primary/10 overflow-hidden">
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 pointer-events-none z-0">
      <p class="text-[14vw] font-heading font-black text-primary/5 tracking-widest whitespace-nowrap select-none">
        MY BOOKS
      </p>
    </div>
    <div class="max-w-4xl mx-auto px-4 text-center relative z-10 space-y-4">
      <h1 class="text-5xl md:text-6xl font-heading font-extrabold text-primary leading-tight">
        Digital Library
      </h1>
    </div>
  </section>

  <section class="bg-card py-24">
    <div class="max-w-7xl mx-auto px-4">
      <div class="grid md:grid-cols-2 gap-12 max-w-5xl mx-auto">
        {englishBooks.map(book => (
          <a
            href={`/en/books/${book.slug}`}
            class="bg-background rounded-3xl border border-primary/10 p-6 md:p-10 shadow-sm hover:shadow-2xl transition-all duration-500 group flex flex-col justify-between items-start hover:-translate-y-3 relative overflow-hidden"
          >
            <div class="absolute top-0 right-0 w-32 h-32 bg-cta/5 rounded-full -mr-16 -mt-16 group-hover:bg-cta/10 transition-colors"></div>

            <div class="w-full relative z-10">
              <!-- Imagen de portada con fallback -->
              <div class="w-full aspect-[3/4] md:aspect-[3/4] mb-6 md:mb-10 bg-card/50 border border-primary/5 rounded-2xl overflow-hidden shadow-2xl transform group-hover:scale-[1.02] transition-transform duration-700 max-h-[280px] md:max-h-none flex items-center justify-center p-4">
                {book.imageAsset
                  ? <Image
                      src={book.imageAsset}
                      alt={`Cover of ${book.title}`}
                      loading="lazy"
                      class="w-full h-full object-contain drop-shadow-xl"
                    />
                  : <div class="w-full h-full bg-primary/10 flex items-center justify-center rounded-xl">
                      <span class="text-primary/30 text-4xl">📚</span>
                    </div>
                }
              </div>

              <div class="space-y-3 md:space-y-4">
                <div class="flex items-center gap-2 text-cta font-outfit text-xs tracking-widest uppercase opacity-70">
                  <span>✦</span> Digital Edition
                </div>
                <h3 class="text-2xl md:text-3xl font-bold font-heading text-primary leading-tight">{book.title}</h3>
                <p class="text-dark/70 font-outfit text-justify leading-relaxed line-clamp-3 text-sm md:text-lg">
                  {book.description}
                </p>
              </div>
            </div>

            <!-- Precio y botón -->
            <div class="w-full flex items-center justify-between mt-8 md:mt-10 pt-6 md:pt-8 border-t border-primary/10 relative z-10">
              <div class="flex flex-col">
                <span class="text-2xl md:text-3xl font-bold font-outfit text-cta">$ {book.price.toFixed(2)} USD</span>
              </div>
              <div
                onclick={`if(window.trackEvent)window.trackEvent('click_get_it_now','purchase','${book.slug}',${book.price})`}
                class="bg-primary text-white px-5 py-3 md:px-8 md:py-4 rounded-xl font-outfit text-sm md:text-lg group-hover:bg-cta transition-all shadow-lg flex items-center gap-2"
              >
                Get it <span class="hidden sm:inline">Now</span>
                <svg class="w-4 h-4 md:w-5 md:h-5 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
                </svg>
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>