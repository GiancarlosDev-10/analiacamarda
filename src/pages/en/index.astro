---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Hero from "../../components/Hero.astro";
import TestimonialsSection from "../../components/TestimonialsSection.astro";
import BooksSection from "../../components/BooksSection.astro";
import MentorSection from "../../components/MentorSection.astro";
import LeadMagnet from "../../components/LeadMagnet.astro";

const schema = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": "https://www.analiacamarda.com/#organization",
      name: "Analía Camarda",
      url: "https://www.analiacamarda.com/",
      logo: "https://www.analiacamarda.com/images/analia-camarda.png",
      sameAs: [
        "https://instagram.com/deafdigitalpro/",
        "https://linkedin.com/in/analia-camarda-2b4152102/",
        "https://tiktok.com/@academydigital1",
      ],
    },
    {
      "@type": "Person",
      "@id": "https://www.analiacamarda.com/#person",
      name: "Analía Camarda",
      jobTitle: "Entrepreneur & Content Creator",
      url: "https://www.analiacamarda.com/",
      sameAs: [
        "https://instagram.com/deafdigitalpro/",
        "https://linkedin.com/in/analia-camarda-2b4152102/",
        "https://tiktok.com/@academydigital1",
      ],
    },
  ],
});
---

<BaseLayout
  title="Analia Camarda | Digital Entrepreneur & Mentor"
  description="Data Analyst, Cybersecurity professional and founder of Academy Digital. Helping the Latino, Hispanic American and Deaf community break into tech. Visit my website to learn more."
  image="/images/logo-stripe.png"
  schema={schema}
  lang="en"
  preloadHero={true}
>
  <!-- 1. HERO -->
  <Hero lang="en" />

  <!-- 2. MENTOR / HISTORIA -->
  <MentorSection lang="en" />

  <!-- 3. TESTIMONIOS -->
  <TestimonialsSection lang="en" />

  <!-- 4. LIBROS -->
  <BooksSection lang="en" />

  <!-- 5. LEAD MAGNET -->
  <LeadMagnet lang="en" />
</BaseLayout>
