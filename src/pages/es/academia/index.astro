---
import BaseLayout from '../../../layouts/BaseLayout.astro';

const schema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Course",
  "name": "Deaf Digital Pro Academy",
  "description": "Una comunidad interactiva en Skool diseñada para enseñar la generación de ingresos pasivos a través de programas dedicados y mentoría semanal.",
  "provider": {
    "@type": "Person",
    "name": "Analía Camarda",
    "url": "https://www.analiacamarda.com"
  }
});
---

<BaseLayout 
  title="Academia Digital | Analía Camarda" 
  description="Únete al Deaf Digital Pro Academy en Skool. Clases ilimitadas, e-books, sesiones en vivo y mentoría personalizada por solo $9/mes."
  schema={schema}
  lang="es"
  image="/images/og-default.png"
>
  <!-- HERO HEADER -->
  <section class="relative bg-background pt-16 pb-10 border-b border-primary/10 overflow-hidden">
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 pointer-events-none z-0">
      <p class="text-[16vw] font-heading font-black text-primary/5 tracking-widest whitespace-nowrap select-none">
        ACADEMIA
      </p>
    </div>
    
    <div class="max-w-4xl mx-auto px-4 text-center relative z-10 space-y-4">
      <div class="font-outfit flex justify-center items-center gap-2 text-cta text-md tracking-widest uppercase">
        <span>✦</span> La Comunidad
      </div>
      <h1 class="text-4xl md:text-6xl font-heading font-extrabold text-primary leading-tight">
        Academia Digital
      </h1>
      <p class="font-outfit text-base md:text-lg text-dark/70 max-w-2xl mx-auto leading-relaxed">
        Donde los emprendedores logran la independencia financiera automatizada. Accede a todas las clases, e-books, sesiones en vivo y mentoría personalizada.
      </p>
    </div>
  </section>

  <!-- PRICING SECTION -->
  <section class="bg-background py-16">
    <div class="max-w-lg mx-auto px-4">

      <!-- PREMIUM CARD -->
      <div class="group relative bg-card rounded-2xl border border-primary/15 p-8 md:p-12 flex flex-col shadow-xl hover:scale-103 transition-all duration-500 hover:bg-primary">

        <!-- Badge -->
        <div class="absolute top-4 right-6 bg-cta text-white px-5 py-1.5 rounded-full text-xs font-bold font-outfit uppercase tracking-widest shadow-lg">
          Más Popular
        </div>

        <div class="font-outfit flex items-center gap-2 text-cta text-sm tracking-widest uppercase mb-4 group-hover:text-white transition-colors">
          <span>✦</span> Premium
        </div>

        <div class="mb-8">
          <div class="text-5xl md:text-6xl font-heading font-extrabold text-primary group-hover:text-white transition-colors">
            $9<span class="text-2xl md:text-3xl font-normal text-dark/60 group-hover:text-white/80 transition-colors">/mes</span>
          </div>
          <p class="font-outfit text-sm text-dark/50 mt-2 group-hover:text-white/70 transition-colors">Cancela cuando quieras</p>
        </div>

        <ul class="space-y-4 mb-10 font-outfit text-dark/90 group-hover:text-white transition-colors">
          <li class="flex items-start gap-3">
            <span class="text-green-500 mt-0.5 group-hover:text-green-300 transition-colors">✓</span>
            <span class="text-base">Clases ilimitadas</span>
          </li>
          <li class="flex items-start gap-3">
            <span class="text-green-500 mt-0.5 group-hover:text-green-300 transition-colors">✓</span>
            <span class="text-base">Todas las clases grabadas</span>
          </li>
          <li class="flex items-start gap-3">
            <span class="text-green-500 mt-0.5 group-hover:text-green-300 transition-colors">✓</span>
            <span class="text-base">Libros ilimitados</span>
          </li>
          <li class="flex items-start gap-3">
            <span class="text-green-500 mt-0.5 group-hover:text-green-300 transition-colors">✓</span>
            <span class="text-base">Mentoría 1:1 personalizada</span>
          </li>
          <li class="flex items-start gap-3">
            <span class="text-green-500 mt-0.5 group-hover:text-green-300 transition-colors">✓</span>
            <span class="text-base">Sesiones en vivo mensuales</span>
          </li>
        </ul>

        <a
          href="https://buy.stripe.com/3cI5kD6FUexR49xa1H3ZK06"
          target="_blank"
          rel="noopener noreferrer"
          onclick={`if(window.trackEvent)window.trackEvent('click_academy_premium','purchase','academy-es',9)`}
          class="w-full bg-cta hover:bg-cta-hover text-white text-center px-6 py-4 rounded-xl font-bold font-outfit text-lg transition-all shadow-lg hover:shadow-xl transform active:scale-95"
        >
          Pagar $9 USD / mes
        </a>

        <p class="font-outfit text-xs text-dark/40 text-center mt-4 group-hover:text-white/60 transition-colors">
          Pago seguro con Stripe · Cifrado SSL
        </p>
      </div>

    </div>
  </section>

  <!-- DUDAS -->
  <section class="bg-card border-t border-primary/20 py-24 text-center">
    <div class="max-w-3xl mx-auto px-4 space-y-8">
      <h2 class="text-4xl font-heading font-bold text-primary">¿Dudas sobre la plataforma?</h2>
      <p class="font-outfit text-xl text-dark/70 leading-relaxed">
        Nuestra academia es una plataforma de aprendizaje comunitario que une cursos, debates y calendarios en un solo lugar accesible. Es increíblemente fácil de usar.
      </p>
      <div class="pt-4">
        <a href="https://wa.me/12393316702" target="_blank" rel="noopener noreferrer" class="text-cta hover:text-dark font-bold font-outfit text-lg flex items-center justify-center gap-2 transition-colors">
          Contáctame Directamente ↗
        </a>
      </div>
    </div>
  </section>
</BaseLayout>