        <!-- PREMIUM CARD -->
        <div
          class="group relative bg-card rounded-2xl border border-primary/15 px-6 pt-5 pb-8 md:px-12 md:pt-8 md:pb-12 flex flex-col shadow-xl hover:scale-103 transition-all duration-500 hover:bg-primary overflow-hidden w-[calc(100vw-4rem)] md:w-full snap-center md:min-w-0 flex-shrink-0 mx-2"
        >
          <div
            class="absolute -top-1 -left-1 overflow-hidden w-40 h-40 pointer-events-none z-20"
