---
import { Image } from 'astro:assets';
import BaseLayout from '../../../layouts/BaseLayout.astro';

const imageFiles = import.meta.glob<{ default: ImageMetadata }>('/src/assets/images/*.{jpeg,jpg,png,gif,webp}');
const imageEntries = Object.entries(imageFiles);

const galleryPhotos = await Promise.all(
  imageEntries
    .filter(([path]) => ![
      'instagram', 'tiktok', 'linkedin',
      'visa', 'mastercard', 'paypal',
      'analia-camarda', 'WiCyS_Deaf', 'whatsapp',
      // Portadas de libros — excluidas de la galería
      'silentsuccess', 'exitosilencioso', 'incomepassive', 'ingresospasivos'
    ].some(exclude => path.toLowerCase().includes(exclude)))
    .map(async ([path, loader]) => {
      const mod = await loader();
      const filename = path.split('/').pop()?.split('.')[0] || 'imagen-galeria';
      const label = filename.split('-').map(word => word.charAt(0).toUpperCase() + word.slice(1)).join(' ');
      
      return {
        src: mod.default,
        alt: `Analía Camarda - ${label}`,
        label: `✦ ${label}`
      };
    })
);
---

<BaseLayout
  title="Galería | Analía Camarda"
  description="Un viaje visual por el mundo de Analía Camarda — emprendedora digital, defensora de la comunidad sorda y mentora de ingresos pasivos."
  image="/images/og-default.png"
  lang="es"
>
  <!-- HERO HEADER -->
  <section class="relative bg-background pt-16 pb-10 border-b border-primary/10 overflow-hidden">
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 pointer-events-none z-0">
      <p class="text-[18vw] font-heading font-black text-primary/5 tracking-widest whitespace-nowrap select-none">
        GALERÍA
      </p>
    </div>
    <div class="max-w-4xl mx-auto px-4 text-center relative z-10 space-y-4">
      <div class="font-outfit flex justify-center items-center gap-2 text-cta text-md tracking-widest uppercase">
        <span>✦</span> Historia Visual
      </div>
      <h1 class="text-5xl md:text-6xl font-heading font-extrabold text-primary leading-tight">
        Mi Galería
      </h1>
      <p class="font-outfit text-lg text-dark/70 max-w-xl mx-auto">
        Un vistazo al mundo de Analía Camarda — defensora, emprendedora y creadora digital.
      </p>
    </div>
  </section>

  <!-- PHOTO GRID -->
  <section class="bg-background py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="columns-1 sm:columns-2 lg:columns-3 gap-6 space-y-6">
        {galleryPhotos.map((photo: any, i: number) => (
          <div class="break-inside-avoid group relative overflow-hidden rounded-2xl border border-primary/15 shadow-md hover:shadow-2xl transition-all duration-500 cursor-pointer">
            <Image
              src={photo.src}
              alt={photo.alt}
              class="w-full object-cover transition-transform duration-700 group-hover:scale-105"
              loading={i < 3 ? 'eager' : 'lazy'}
            />
            <!-- Overlay -->
            <div class="absolute inset-0 bg-gradient-to-t from-primary/60 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500 flex items-end p-5">
              <span class="font-outfit text-sm font-bold text-white tracking-widest uppercase">
                {photo.label}
              </span>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="bg-card border-t border-primary/20 py-20 text-center">
    <div class="max-w-2xl mx-auto px-4 space-y-6">
      <h2 class="text-3xl font-heading font-bold text-primary">¿Quieres trabajar juntos?</h2>
      <p class="font-outfit text-dark/70 text-lg">Únete a la Deaf Digital Pro Academy y empieza a construir tu camino hacia los ingresos pasivos.</p>
      <a
        href="https://skool.com/deafdigitalpro"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-block bg-cta hover:bg-dark text-white px-10 py-4 rounded-full font-bold font-outfit transition-all shadow-lg hover:shadow-xl"
      >
        Unirse a Premium ↗
      </a>
    </div>
  </section>
</BaseLayout>
