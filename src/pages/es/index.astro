---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Hero from "../../components/Hero.astro";
import TestimonialsSection from "../../components/TestimonialsSection.astro";
import BooksSection from "../../components/BooksSection.astro";
import MentorSection from "../../components/MentorSection.astro";
import LeadMagnet from "../../components/LeadMagnet.astro";

const schema = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": "https://www.analiacamarda.com/#organization",
      name: "Analía Camarda",
      url: "https://www.analiacamarda.com/",
      logo: "https://www.analiacamarda.com/images/analia-camarda.png",
      sameAs: [
        "https://instagram.com/deafdigitalpro/",
        "https://linkedin.com/in/analia-camarda-2b4152102/",
        "https://tiktok.com/@academydigital1",
      ],
    },
    {
      "@type": "Person",
      "@id": "https://www.analiacamarda.com/#person",
      name: "Analía Camarda",
      jobTitle: "Emprendedora y Creadora de Contenido",
      url: "https://www.analiacamarda.com/",
      sameAs: [
        "https://instagram.com/deafdigitalpro/",
        "https://linkedin.com/in/analia-camarda-2b4152102/",
        "https://tiktok.com/@academydigital1",
      ],
    },
  ],
});
---

<BaseLayout
  title="Analía Camarda | Emprendedora Digital y Mentora"
  description="Analista de Datos, profesional en Ciberseguridad y fundadora de Academy Digital. Ayudando a la comunidad latina, hispana y sorda a ingresar al mundo tecnológico. Visita mi sitio web para saber más."
  image="/images/logo-stripe.png"
  schema={schema}
  lang="es"
  preloadHero={true}
>
  <!-- 1. HERO -->
  <Hero lang="es" />

  <!-- 2. MENTORA / HISTORIA -->
  <MentorSection lang="es" />

  <!-- 3. TESTIMONIOS -->
  <TestimonialsSection lang="es" />

  <!-- 4. LIBROS -->
  <BooksSection lang="es" />

  <!-- 5. LEAD MAGNET -->
  <LeadMagnet lang="es" />
</BaseLayout>
