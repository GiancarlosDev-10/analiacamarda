---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import booksData from '../../../data/books.json';

const spanishBooks = booksData.filter(b => b.lang === 'es');
---

<BaseLayout 
  title="Librería Digital | Analía Camarda" 
  description="Explora la colección completa de e-books de Analía Camarda para aprender sobre ingresos pasivos y libertad financiera."
  lang="es"
>
  <!-- HERO HEADER -->
  <section class="relative bg-background pt-16 pb-10 border-b border-primary/10 overflow-hidden">
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 pointer-events-none z-0">
      <p class="text-[14vw] font-heading font-black text-primary/5 tracking-widest whitespace-nowrap select-none">
        MIS LIBROS
      </p>
    </div>
    <div class="max-w-4xl mx-auto px-4 text-center relative z-10 space-y-4">
      <div class="font-outfit flex justify-center items-center gap-2 text-cta text-lg tracking-widest uppercase">
        <span>✦</span> Librería Digital
      </div>
      <h1 class="text-5xl md:text-6xl font-heading font-extrabold text-primary leading-tight">
        La Colección <span class="italic text-cta">Digital</span>
      </h1>
      <p class="font-outfit text-xl text-dark/70 max-w-2xl mx-auto leading-relaxed">
        Mi colección completa de guías prácticas diseñadas para ayudar a la comunidad sorda e hispana a alcanzar la independencia financiera.
      </p>
    </div>
  </section>

  <section class="bg-card py-24">
    <div class="max-w-7xl mx-auto px-4">
      <div class="grid md:grid-cols-2 gap-12 max-w-5xl mx-auto">
         {spanishBooks.map(book => (
           <a href={`/es/libros/${book.slug}`} class="bg-background rounded-3xl border border-primary/10 p-10 shadow-sm hover:shadow-2xl transition-all duration-500 group flex flex-col justify-between items-start hover:-translate-y-3 relative overflow-hidden">
              <div class="absolute top-0 right-0 w-32 h-32 bg-cta/5 rounded-full -mr-16 -mt-16 group-hover:bg-cta/10 transition-colors"></div>
              
              <div class="w-full relative z-10">
                <div class="w-full aspect-[3/4] mb-10 bg-card border border-primary/5 rounded-2xl overflow-hidden shadow-2xl transform group-hover:scale-[1.02] transition-transform duration-700">
                  <img src={book.coverImage} alt={`Portada de ${book.title}`} class="w-full h-full object-cover" />
                </div>
                <div class="space-y-4">
                  <div class="flex items-center gap-2 text-cta font-outfit text-md tracking-widest uppercase opacity-70">
                    <span>✦</span> Edición Digital
                  </div>
                  <h3 class="text-3xl font-bold font-heading text-primary leading-tight">{book.title}</h3>
                  <p class="text-dark/70 font-outfit text-justify leading-relaxed line-clamp-3 text-lg">
                    {book.description}
                  </p>
                </div>
              </div>
              
              <div class="w-full flex items-center justify-between mt-10 pt-8 border-t border-primary/10 relative z-10">
                <div class="flex flex-col">
                  <span class="text-xs font-bold font-outfit text-dark/40 uppercase tracking-widest mb-1">Inversión</span>
                  <span class="text-3xl font-bold font-outfit text-cta">${book.price.toFixed(2)}</span>
                </div>
                <div onclick={`if(window.trackEvent)window.trackEvent('click_get_it_now','purchase','${book.slug}',${book.price})`} class="bg-primary text-white px-8 py-4 rounded-xl font-outfit text-lg group-hover:bg-cta transition-all shadow-lg flex items-center gap-2">
                  Obtener Ahora <svg class="w-5 h-5 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
                </div>
              </div>
           </a>
         ))}
      </div>
    </div>
  </section>
</BaseLayout>
